@page
@model SaigonChe.Web.Areas.Identity.Pages.Account.Manage.ProfileModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
    ViewData["Title"] = "Hồ sơ";
}

<h2>Hồ sơ</h2>
<p>Cập nhật số điện thoại liên hệ của bạn.</p>

@if (TempData["ProfileSaved"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <div class="mb-3">
        <label class="form-label" for="profile-username">Tên đăng nhập</label>
        <input class="form-control" id="profile-username" value="@Model.UserName" readonly />
    </div>
    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
        <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
</form>
