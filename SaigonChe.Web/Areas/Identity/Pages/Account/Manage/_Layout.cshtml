@using Microsoft.AspNetCore.Identity
@using SaigonChe.Web.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject SignInManager<ApplicationUser> SignInManager
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var links = new List<(string Page, string Label)>
    {
        ("Index", "Hồ sơ"),
        ("Email", "Email"),
        ("ChangePassword", "Mật khẩu"),
        ("TwoFactorAuthentication", "Xác thực hai bước"),
        ("PersonalData", "Dữ liệu cá nhân")
    };
    if ((await SignInManager.GetExternalAuthenticationSchemesAsync()).Any())
    {
        links.Add(("ExternalLogins", "Đăng nhập liên kết"));
    }
}

<header class="page-head">
    <span class="eyebrow">Tài khoản</span>
    <h1>Cài đặt tài khoản</h1>
</header>

<div class="account-settings-grid">
    <nav class="nav nav-pills flex-column" aria-label="Cài đặt tài khoản">
        @foreach (var link in links)
        {
            var target = $"/Account/Manage/{link.Page}";
            var active = string.Equals(currentPage, target, StringComparison.OrdinalIgnoreCase);
            <a class="nav-link @(active ? "active" : "")" asp-area="Identity" asp-page="@target"
               aria-current="@(active ? "page" : null)">@link.Label</a>
        }
    </nav>
    <div class="account-settings-panel">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
