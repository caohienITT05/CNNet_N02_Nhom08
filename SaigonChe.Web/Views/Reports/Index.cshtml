@model SaigonChe.Web.ViewModels.ReportDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo doanh thu";
    ViewData["BodyClass"] = "reports-page";
}

<section class="section container" aria-label="@ViewData["Title"]">
<div class="admin-page-head report-screen-only">
    <div>
        <span class="eyebrow">Phân tích kinh doanh</span>
        <h1>Báo cáo doanh thu</h1>
        <p>Chỉ tính đơn đã thanh toán và hoàn thành trong khoảng ngày đã chọn.</p>
    </div>
    <div class="btn-row">
        <a class="btn btn-secondary" asp-action="ExportExcel" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-type="@Model.Type">Xuất Excel</a>
        <button class="btn btn-primary" type="button" onclick="window.print()">In / lưu PDF</button>
    </div>
</div>

<form method="get" class="report-filters report-screen-only">
    <label>Từ ngày <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></label>
    <label>Đến ngày <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></label>
    <label>Loại đơn
        <select name="type">
            <option value="">Tất cả</option>
            <option value="Online" selected="@(Model.Type == "Online")">Online</option>
            <option value="Pos" selected="@(Model.Type == "Pos")">POS</option>
            <option value="Party" selected="@(Model.Type == "Party")">Đặt tiệc</option>
        </select>
    </label>
    <button class="btn btn-secondary" type="submit">Lọc báo cáo</button>
</form>

<div class="stat-grid report-stat-grid">
    <article class="stat-card"><span class="stat-label">Doanh thu thuần</span><p class="stat-value">@Model.Revenue.ToString("N0") ₫</p><span class="stat-hint">Sau giảm giá</span></article>
    <article class="stat-card"><span class="stat-label">Đơn hoàn thành</span><p class="stat-value">@Model.OrderCount</p><span class="stat-hint">Đã thanh toán</span></article>
    <article class="stat-card"><span class="stat-label">Khách có tài khoản</span><p class="stat-value">@Model.CustomerCount</p><span class="stat-hint">Khách hàng trong kỳ</span></article>
    <article class="stat-card"><span class="stat-label">Đơn POS khách vãng lai</span><p class="stat-value">@Model.GuestPosOrderCount</p><span class="stat-hint">Không gắn tài khoản</span></article>
</div>

<div class="report-chart-grid">
    <section class="report-chart-card"><h2>Doanh thu theo ngày</h2><canvas id="dailyRevenueChart" aria-label="Biểu đồ doanh thu theo ngày" role="img"></canvas></section>
    <section class="report-chart-card"><h2>Doanh thu theo tháng</h2><canvas id="monthlyRevenueChart" aria-label="Biểu đồ doanh thu theo tháng" role="img"></canvas></section>
</div>

<section class="report-table-card">
    <div class="report-section-head"><div><h2>Món bán chạy</h2><p>Top món theo số phần trong các đơn đủ điều kiện.</p></div></div>
    <div class="table-responsive"><table class="admin-table"><thead><tr><th>Món</th><th>Số phần</th><th>Giá trị món</th></tr></thead><tbody>
    @if (Model.BestSellers.Count == 0) { <tr><td colspan="3">Chưa có dữ liệu trong khoảng thời gian này.</td></tr> }
    @foreach (var item in Model.BestSellers) { <tr><td>@item.Name</td><td>@item.Units</td><td>@item.Revenue.ToString("N0") ₫</td></tr> }
    </tbody></table></div>
</section>

<section class="report-table-card">
    <div class="report-section-head"><div><h2>Đơn hoàn thành gần đây</h2><p>Thời gian hiển thị theo múi giờ Việt Nam. File Excel chứa danh sách đầy đủ trong kỳ.</p></div></div>
    <div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Hoàn thành</th><th>Loại</th><th>Khách hàng</th><th>Số phần</th><th>Doanh thu thuần</th></tr></thead><tbody>
    @if (Model.Orders.Count == 0) { <tr><td colspan="6">Chưa có đơn phù hợp.</td></tr> }
    @foreach (var order in Model.Orders) { <tr><td>#@order.Id</td><td>@order.CompletedAtLocal.ToString("dd/MM/yyyy HH:mm")</td><td>@order.Type</td><td>@order.Customer</td><td>@order.Units</td><td>@order.Revenue.ToString("N0") ₫</td></tr> }
    </tbody></table></div>
</section>
</section>

@section Head {
    <style>
        .report-filters{display:flex;gap:1rem;align-items:end;flex-wrap:wrap;margin:0 0 1.25rem;padding:1rem;border:1px solid rgba(89,58,42,.18);border-radius:14px;background:var(--white)}
        .report-filters label{display:grid;gap:.35rem;font-size:.82rem;color:var(--muted)}
        .report-filters input,.report-filters select{min-height:42px;padding:.5rem .7rem;border-radius:8px;border:1px solid rgba(89,58,42,.18);background:var(--cream-bg);color:inherit}
        .report-chart-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1rem 0}
        .report-chart-card,.report-table-card{margin:1rem 0;padding:1rem;border:1px solid rgba(89,58,42,.18);border-radius:14px;background:var(--white)}
        .report-chart-card h2,.report-table-card h2{font-size:1.05rem;margin:0 0 1rem}
        .report-chart-card{min-width:0}
        .report-chart-card canvas{max-width:100%;max-height:290px}
        .report-section-head{margin-bottom:.8rem}.report-section-head p{margin:0;color:var(--muted)}
        @@media(max-width:760px){.report-chart-grid{grid-template-columns:minmax(0,1fr)}}
        @@media print{.report-screen-only,header,footer,.admin-sidebar,.admin-topbar,.skip-link{display:none!important}.admin-main,.admin-content{margin:0!important;padding:0!important}.report-table-card,.stat-card{break-inside:avoid;background:white!important;color:#111!important;border-color:#bbb!important}.stat-label,.stat-hint{color:#444!important}body{background:#fff!important;color:#111!important}}
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const daily = @Html.Raw(JsonSerializer.Serialize(Model.DailyRevenue, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
        const monthly = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
        const money = value => new Intl.NumberFormat('vi-VN').format(value) + ' ₫';
        function renderRevenueChart(id, items) {
            const node = document.getElementById(id);
            if (!node || !window.Chart) return;
            new Chart(node, { type: 'bar', data: { labels: items.map(item => item.label), datasets: [{ data: items.map(item => item.revenue), backgroundColor: '#b74637', borderRadius: 6 }] }, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: false }, tooltip: { callbacks: { label: context => money(context.raw) } } }, scales: { y: { ticks: { callback: value => new Intl.NumberFormat('vi-VN', { notation: 'compact' }).format(value) } } } } });
        }
        renderRevenueChart('dailyRevenueChart', daily);
        renderRevenueChart('monthlyRevenueChart', monthly);
    </script>
}
