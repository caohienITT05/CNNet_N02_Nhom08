@model SaigonChe.Web.ViewModels.ReportDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo doanh thu";
    ViewData["BodyClass"] = "reports-page";
}

<div class="report-print-heading">
    <h1>Báo cáo doanh thu</h1>
    <p>@Model.From.ToString("dd/MM/yyyy") – @Model.To.ToString("dd/MM/yyyy") · @(Model.Type ?? "Tất cả loại đơn") · Giờ Việt Nam</p>
</div>

<div class="admin-page-head report-screen-only">
    <div>
        <span class="eyebrow">Phân tích kinh doanh</span>
        <h1>Dashboard báo cáo</h1>
        <p>Chỉ tính đơn đã thanh toán và hoàn thành trong khoảng ngày đã chọn.</p>
    </div>
    <div class="btn-row">
        <a class="btn btn-secondary" asp-action="ExportExcel" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-type="@Model.Type">
            <svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>
            Xuất Excel
        </a>
        <button class="btn btn-primary" type="button" onclick="window.print()">
            <svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>
            In / lưu PDF
        </button>
    </div>
</div>

<div asp-validation-summary="All" class="text-danger report-screen-only"></div>

<form method="get" class="report-filters report-screen-only">
    <label>
        Từ ngày
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
    </label>
    <label>
        Đến ngày
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
    </label>
    <label>
        Loại đơn
        <select name="type">
            <option value="">Tất cả</option>
            <option value="Online" selected="@(Model.Type == "Online")">Online</option>
            <option value="Pos" selected="@(Model.Type == "Pos")">POS</option>
            <option value="Party" selected="@(Model.Type == "Party")">Đặt tiệc</option>
        </select>
    </label>
    <button class="btn btn-primary" type="submit">Lọc báo cáo</button>
</form>

<div class="stat-grid report-stat-grid">
    <article class="stat-card"><span class="stat-label">Doanh thu thuần</span><p class="stat-value">@Model.Revenue.ToString("N0") ₫</p><span class="stat-hint">Sau giảm giá</span></article>
    <article class="stat-card"><span class="stat-label">Đơn hoàn thành</span><p class="stat-value">@Model.OrderCount</p><span class="stat-hint">Đã thanh toán</span></article>
    <article class="stat-card"><span class="stat-label">Khách có tài khoản</span><p class="stat-value">@Model.CustomerCount</p><span class="stat-hint">Khách hàng trong kỳ</span></article>
    <article class="stat-card"><span class="stat-label">Đơn POS khách vãng lai</span><p class="stat-value">@Model.GuestPosOrderCount</p><span class="stat-hint">Không gắn tài khoản</span></article>
</div>

<div class="report-chart-grid">
    <section class="report-chart-card">
        <h2>Doanh thu theo ngày</h2>
        <div class="report-chart-frame"><canvas id="dailyRevenueChart" aria-label="Biểu đồ doanh thu theo ngày" role="img"></canvas></div>
    </section>
    <section class="report-chart-card">
        <h2>Doanh thu theo tháng</h2>
        <div class="report-chart-frame"><canvas id="monthlyRevenueChart" aria-label="Biểu đồ doanh thu theo tháng" role="img"></canvas></div>
    </section>
</div>

<section class="report-table-card">
    <div class="report-section-head">
        <div>
            <h2>Món bán chạy</h2>
            <p>Top món theo số phần trong các đơn đủ điều kiện.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>Món</th><th>Số phần</th><th>Giá trị món</th></tr></thead>
            <tbody>
                @if (Model.BestSellers.Count == 0)
                {
                    <tr><td colspan="3">Chưa có dữ liệu trong khoảng thời gian này.</td></tr>
                }
                @foreach (var item in Model.BestSellers)
                {
                    <tr><td>@item.Name</td><td>@item.Units</td><td>@item.Revenue.ToString("N0") ₫</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="report-table-card">
    <div class="report-section-head">
        <div>
            <h2>Đơn hoàn thành gần đây</h2>
            <p>Thời gian hiển thị theo múi giờ Việt Nam. File Excel chứa danh sách đầy đủ trong kỳ.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>Mã đơn</th><th>Hoàn thành</th><th>Loại</th><th>Khách hàng</th><th>Số phần</th><th>Doanh thu thuần</th></tr></thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="6">Chưa có đơn phù hợp.</td></tr>
                }
                @foreach (var order in Model.Orders)
                {
                    <tr><td>#@order.Id</td><td>@order.CompletedAtLocal.ToString("dd/MM/yyyy HH:mm")</td><td>@order.Type</td><td>@order.Customer</td><td>@order.Units</td><td>@order.Revenue.ToString("N0") ₫</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="/lib/chartjs/chart.umd.min.js"></script>
    <script>
        const daily = @Html.Raw(JsonSerializer.Serialize(Model.DailyRevenue, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
        const monthly = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
        const money = value => new Intl.NumberFormat('vi-VN').format(value) + ' ₫';
        const accent = () => getComputedStyle(document.documentElement).getPropertyValue('--primary').trim() || '#e0a54a';
        function renderRevenueChart(id, items) {
            const node = document.getElementById(id);
            if (!node || !window.Chart) return;
            new Chart(node, { type: 'bar', data: { labels: items.map(item => item.label), datasets: [{ data: items.map(item => item.revenue), backgroundColor: accent(), borderRadius: 6 }] }, options: { responsive: true, animation: false, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: context => money(context.raw) } } }, scales: { y: { ticks: { callback: value => new Intl.NumberFormat('vi-VN', { notation: 'compact' }).format(value) } } } } });
        }
        renderRevenueChart('dailyRevenueChart', daily);
        renderRevenueChart('monthlyRevenueChart', monthly);
        function updateChartTheme() {
            if (!window.Chart) return;
            const printing = window.matchMedia('print').matches;
            const tokens = getComputedStyle(document.documentElement);
            const text = printing ? '#444' : tokens.getPropertyValue('--muted-foreground').trim();
            const line = printing ? '#ddd' : tokens.getPropertyValue('--border').trim();
            Object.values(Chart.instances).forEach(chart => {
                ['x','y'].forEach(axis => {
                    chart.options.scales[axis].ticks.color = text;
                    chart.options.scales[axis].grid.color = line;
                });
                chart.data.datasets.forEach(set => set.backgroundColor = printing ? '#c79453' : accent());
                chart.update('none');
                if (printing) preparePrintChart(chart);
                else chart.resize();
            });
        }
        function preparePrintChart(chart) {
            const frame = chart.canvas.parentElement;
            frame.querySelector('.print-chart-image')?.remove();
            const canvas = document.createElement('canvas');
            canvas.width = 800;
            canvas.height = 150;
            const snapshot = new Chart(canvas, {
                type: 'bar',
                data: {labels: [...chart.data.labels], datasets: chart.data.datasets.map(set => ({...set, data: [...set.data], backgroundColor: '#c79453'}))},
                options: {
                    responsive: false, animation: false, devicePixelRatio: 2,
                    plugins: {legend: {display: false}},
                    scales: {
                        x: {ticks: {color: '#444'}, grid: {color: '#ddd'}},
                        y: {ticks: {maxTicksLimit: 6, color: '#444', callback: value => new Intl.NumberFormat('vi-VN', {notation:'compact'}).format(value)}, grid: {color: '#ddd'}}
                    }
                }
            });
            const image = document.createElement('img');
            image.className = 'print-chart-image';
            image.alt = chart.canvas.getAttribute('aria-label') || 'Biểu đồ doanh thu';
            image.src = canvas.toDataURL('image/png');
            snapshot.destroy();
            frame.append(image);
        }
        updateChartTheme();
        new MutationObserver(updateChartTheme).observe(document.documentElement, {attributes:true,attributeFilter:['data-theme']});
        window.matchMedia('print').addEventListener('change', updateChartTheme);
        window.addEventListener('beforeprint', updateChartTheme);
        window.addEventListener('afterprint', updateChartTheme);
    </script>
}
