@model SaigonChe.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard doanh thu";
    var maxDailyRevenue = Model.DailyRevenue.Count == 0
        ? 0m
        : Model.DailyRevenue.Max(item => item.Revenue);
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h2>Dashboard Doanh Thu</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Products" class="btn btn-secondary">Sản phẩm</a>
                <a asp-action="Categories" class="btn btn-secondary">Danh mục</a>
                <a asp-action="Orders" class="btn btn-secondary">Đơn hàng</a>
                <a asp-action="Staff" class="btn btn-secondary">Nhân viên</a>
                <a asp-action="ContactMessages" class="btn btn-secondary">Liên hệ</a>
                <a asp-controller="AdminReviews" asp-action="Index" class="btn btn-secondary">Đánh giá</a>
                <a asp-controller="AdminCustomers" asp-action="Index" class="btn btn-secondary">Khách hàng</a>
            </div>
        </div>

        <form asp-action="Dashboard" method="get" class="dashboard-filter mt-4">
            <div>
                <label asp-for="FromDate" class="form-label">Từ ngày</label>
                <input asp-for="FromDate" type="date" class="form-control" />
            </div>
            <div>
                <label asp-for="ToDate" class="form-label">Đến ngày</label>
                <input asp-for="ToDate" type="date" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Xem báo cáo</button>
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger mt-3" role="alert"></div>
        }

        @if (Model.DailyRevenue.Count > 0)
        {
            <p class="dashboard-note mt-3 mb-0">
                Doanh thu được tính từ đơn đã hoàn thành trong khoảng @Model.FromDate.ToString("dd/MM/yyyy")
                đến @Model.ToDate.ToString("dd/MM/yyyy"). Đơn hủy không được tính.
            </p>

            <div class="dashboard-metrics mt-4">
                <article class="dashboard-metric">
                    <span>Doanh thu</span>
                    <strong>@Model.Revenue.ToString("N0")₫</strong>
                </article>
                <article class="dashboard-metric">
                    <span>Đơn hoàn thành</span>
                    <strong>@Model.CompletedOrderCount</strong>
                </article>
                <article class="dashboard-metric">
                    <span>Giá trị trung bình / đơn</span>
                    <strong>@Model.AverageOrderValue.ToString("N0")₫</strong>
                </article>
                <article class="dashboard-metric">
                    <span>Đơn đang xử lý</span>
                    <strong>@Model.ProcessingOrderCount</strong>
                    <small>Toàn hệ thống</small>
                </article>
                <article class="dashboard-metric">
                    <span>Đánh giá mới</span>
                    <strong>@Model.NewReviewCount</strong>
                    <small>Trong 7 ngày gần nhất</small>
                </article>
                <article class="dashboard-metric">
                    <span>Khách hàng</span>
                    <strong>@Model.CustomerCount</strong>
                    <small>Không gồm Admin và Staff</small>
                </article>
            </div>

            <div class="dashboard-sections mt-4">
                <section class="dashboard-panel">
                    <h3>Doanh thu theo ngày</h3>
                    @if (maxDailyRevenue > 0)
                    {
                        <div class="daily-revenue-list">
                            @foreach (var day in Model.DailyRevenue)
                            {
                                var width = day.Revenue > 0 ? day.Revenue / maxDailyRevenue * 100 : 0;
                                <div class="daily-revenue-row">
                                    <time datetime="@day.Date.ToString("yyyy-MM-dd")">@day.Date.ToString("dd/MM")</time>
                                    <div class="daily-revenue-track"
                                         role="img"
                                         aria-label="@day.Date.ToString("dd/MM/yyyy"): @day.Revenue.ToString("N0") đồng">
                                        <span style="width: @width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                    </div>
                                    <strong>@day.Revenue.ToString("N0")₫</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có doanh thu hoàn thành trong khoảng thời gian này.</p>
                    }
                </section>

                <section class="dashboard-panel">
                    <h3>Top món bán chạy</h3>
                    @if (Model.PopularProducts.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table align-middle admin-table">
                                <thead>
                                    <tr>
                                        <th>Món</th>
                                        <th>Số lượng</th>
                                        <th>Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.PopularProducts)
                                    {
                                        <tr>
                                            <td>@product.ProductName</td>
                                            <td>@product.Quantity</td>
                                            <td>@product.Revenue.ToString("N0")₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có món bán hoàn thành trong khoảng thời gian này.</p>
                    }
                </section>
            </div>
        }
    </div>
</section>
