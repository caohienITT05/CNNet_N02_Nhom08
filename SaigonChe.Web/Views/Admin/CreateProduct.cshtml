@model SaigonChe.Web.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Thêm món";
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Thực đơn</span>
        <h1>Thêm món mới</h1>
        <p>Món mới sẽ xuất hiện trên thực đơn ngay khi được lưu.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Products" class="btn btn-ghost">Quay lại</a>
    </div>
</div>

<div class="admin-form-wrap">
    <form asp-action="CreateProduct" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-validation" role="alert"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name" class="form-label">Tên món</label>
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Chè ba màu" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="form-label">Giá (VNĐ)</label>
                <input asp-for="Price" class="form-control" type="number" min="1000" step="1000" placeholder="25000" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile" class="form-label">Ảnh món</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <small class="form-text">JPG, PNG hoặc WEBP, tối đa 5MB.</small>
                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nguyên liệu, hương vị và điểm đặc biệt của món…"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-3 flex-wrap">
            <div class="form-check">
                <input asp-for="IsAvailable" class="form-check-input" />
                <label asp-for="IsAvailable" class="form-check-label">Còn bán</label>
            </div>
            <div class="form-check">
                <input asp-for="IsFeatured" class="form-check-input" />
                <label asp-for="IsFeatured" class="form-check-label">Món bán chạy</label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                Lưu món
            </button>
            <a asp-action="Products" class="btn btn-ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
