@model List<SaigonChe.Web.Models.ContactMessage>
@{
    ViewData["Title"] = "Liên hệ khách hàng";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h2>Liên Hệ Khách Hàng</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Products" class="btn btn-secondary">Sản phẩm</a>
                <a asp-action="Categories" class="btn btn-secondary">Danh mục</a>
                <a asp-action="Orders" class="btn btn-secondary">Đơn hàng</a>
            </div>
        </div>

        @if (TempData["AdminSuccess"] is string success)
        {
            <div class="alert alert-success mt-3" role="status">@success</div>
        }

        <div class="table-responsive mt-4">
            <table class="table table-striped align-middle admin-table">
                <thead>
                    <tr>
                        <th>Trạng thái</th>
                        <th>Khách hàng</th>
                        <th>Thông tin liên hệ</th>
                        <th>Nội dung</th>
                        <th>Thời gian</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge @(message.IsRead ? "bg-secondary" : "bg-warning text-dark")">
                                    @(message.IsRead ? "Đã xem" : "Mới")
                                </span>
                            </td>
                            <td>@message.FullName</td>
                            <td>@message.Contact</td>
                            <td class="contact-message-content">@message.Message</td>
                            <td>@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (!message.IsRead)
                                    {
                                        <form asp-action="MarkContactMessageRead" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@message.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm">Đánh dấu đã xem</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteContactMessage" method="post"
                                          onsubmit="return confirm('Xóa liên hệ này khỏi hệ thống?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@message.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa nhận được liên hệ nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
