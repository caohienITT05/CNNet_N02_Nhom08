@model List<SaigonChe.Web.Models.ContactMessage>
@{
    ViewData["Title"] = "Tin nhắn liên hệ";
    var unread = Model.Count(message => !message.IsRead);
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Chăm sóc khách hàng</span>
        <h1>Tin nhắn liên hệ</h1>
        <p>Mọi lời nhắn từ khách hàng, gom về một nơi.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Orders" class="btn btn-secondary btn-sm">Đơn hàng</a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-mail" /></svg>Tổng tin nhắn</span>
        <p class="stat-value">@Model.Count</p>
        <span class="stat-hint">Từ khách hàng trên website</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>Chưa xem</span>
        <p class="stat-value">@unread</p>
        <span class="stat-hint">Cần phản hồi sớm</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Đã xem</span>
        <p class="stat-value">@(Model.Count - unread)</p>
        <span class="stat-hint">Đã xử lý</span>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="table admin-table">
        <thead>
            <tr>
                <th>Trạng thái</th>
                <th>Khách hàng</th>
                <th>Liên hệ</th>
                <th>Nội dung</th>
                <th>Thời gian</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in Model)
            {
                <tr>
                    <td>
                        @if (message.IsRead)
                        {
                            <span class="badge badge-secondary">Đã xem</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Mới</span>
                        }
                    </td>
                    <td>
                        <span class="cell-strong">@message.FullName</span>
                    </td>
                    <td class="cell-mono">@message.Contact</td>
                    <td class="contact-message-content">@message.Message</td>
                    <td class="cell-muted">@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @if (!message.IsRead)
                            {
                                <form asp-action="MarkContactMessageRead" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@message.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">Đánh dấu đã xem</button>
                                </form>
                            }
                            <form asp-action="DeleteContactMessage" method="post"
                                  data-confirm="Tin nhắn của “@message.FullName” sẽ bị xóa vĩnh viễn."
                                  data-confirm-title="Xóa tin nhắn?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@message.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state" style="border:0;background:transparent">
                            <p>Chưa có tin nhắn nào. Tin nhắn từ biểu mẫu liên hệ sẽ hiện ở đây.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
