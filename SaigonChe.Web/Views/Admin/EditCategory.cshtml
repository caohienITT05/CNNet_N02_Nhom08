@model SaigonChe.Web.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Thực đơn</span>
        <h1>Cập nhật danh mục</h1>
        <p>Thay đổi tên hoặc mô tả hiển thị của danh mục.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Categories" class="btn btn-ghost">Quay lại</a>
    </div>
</div>

<div class="admin-form-wrap">
    <form asp-action="EditCategory" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-validation" role="alert"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                Lưu thay đổi
            </button>
            <a asp-action="Categories" class="btn btn-ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
