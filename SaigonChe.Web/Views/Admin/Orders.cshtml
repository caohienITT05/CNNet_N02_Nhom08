@model List<SaigonChe.Web.Models.Order>
@using SaigonChe.Web.Models
@{
    ViewData["Title"] = "Đơn hàng";
    var pending = Model.Count(order => order.Status is OrderStatus.Pending or OrderStatus.Confirmed or OrderStatus.Preparing);
    var completed = Model.Count(order => order.Status == OrderStatus.Completed);
    var revenue = Model.Where(order => order.IsPaid && order.Status == OrderStatus.Completed).Sum(order => order.Total);
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Vận hành</span>
        <h1>Đơn hàng</h1>
        <p>Theo dõi đơn mới, cập nhật trạng thái và xem chi tiết từng đơn.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Products" class="btn btn-secondary btn-sm">Thực đơn</a>
        <a asp-action="ContactMessages" class="btn btn-ghost btn-sm">Tin nhắn</a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>Tổng đơn</span>
        <p class="stat-value">@Model.Count</p>
        <span class="stat-hint">Toàn bộ thời gian</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>Đang xử lý</span>
        <p class="stat-value">@pending</p>
        <span class="stat-hint">Chờ xác nhận hoặc đang chuẩn bị</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Hoàn thành</span>
        <p class="stat-value">@completed</p>
        <span class="stat-hint">Đã giao thành công</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-tag" /></svg>Doanh thu</span>
        <p class="stat-value">@revenue.ToString("N0")₫</p>
        <span class="stat-hint">Đơn đã thanh toán và hoàn thành</span>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="table admin-table">
        <thead>
            <tr>
                <th>Đơn</th>
                <th>Khách hàng</th>
                <th>Liên hệ / Địa chỉ</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Cập nhật</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var statusText = order.Status switch
                {
                    OrderStatus.Pending => "Chờ xác nhận",
                    OrderStatus.Confirmed => "Đã xác nhận",
                    OrderStatus.Preparing => "Đang chuẩn bị",
                    OrderStatus.Completed => "Đã hoàn thành",
                    _ => "Đã hủy"
                };
                var statusClass = order.Status switch
                {
                    OrderStatus.Pending => "badge-warning",
                    OrderStatus.Confirmed => "badge",
                    OrderStatus.Preparing => "badge",
                    OrderStatus.Completed => "badge-success",
                    _ => "badge-danger"
                };
                var nextStatuses = order.Status switch
                {
                    OrderStatus.Pending => new[] { OrderStatus.Confirmed, OrderStatus.Cancelled },
                    OrderStatus.Confirmed => new[] { OrderStatus.Preparing, OrderStatus.Cancelled },
                    OrderStatus.Preparing => new[] { OrderStatus.Completed, OrderStatus.Cancelled },
                    _ => Array.Empty<OrderStatus>()
                };

                <tr>
                    <td>
                        <details>
                            <summary>#@order.Id · @order.Type · @order.Items.Count món</summary>
                            <ul>
                                @foreach (var item in order.Items)
                                {
                                    <li>@item.ProductName × @item.Quantity — @((item.Price * item.Quantity).ToString("N0"))₫</li>
                                }
                            </ul>
                        </details>
                    </td>
                    <td>
                        <span class="cell-strong">@order.CustomerName</span>
                    </td>
                    <td>
                        <span class="cell-mono">@order.Phone</span>
                        <div class="cell-muted">@order.Address</div>
                    </td>
                    <td class="cell-muted">@VietnamTime.ToLocal(order.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="cell-mono">@order.Total.ToString("N0")₫</td>
                    <td>
                        <span class="badge @statusClass">@statusText</span>
                        @if (order.Status == OrderStatus.Completed && !order.IsPaid)
                        {
                            <div class="cell-muted">Đơn cũ · chưa xác minh thanh toán</div>
                        }
                    </td>
                    <td>
                        @if (order.Type != OrderType.Online)
                        {
                            <span class="cell-muted">Cập nhật tại POS / Đặt tiệc</span>
                        }
                        else
                        {
                        <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OrderId" value="@order.Id" />
                            <select name="Status" class="form-select form-select-sm" aria-label="Trạng thái đơn hàng @order.Id" style="min-width:148px" disabled="@(nextStatuses.Length == 0)">
                                @foreach (var statusOption in Html.GetEnumSelectList<OrderStatus>().Where(option => nextStatuses.Any(status => ((int)status).ToString() == option.Value)))
                                {
                                    <option value="@statusOption.Value">@statusOption.Text</option>
                                }
                            </select>
                            <input type="text" name="Note" maxlength="500" class="form-control form-control-sm" placeholder="Ghi chú / lý do hủy" aria-label="Ghi chú hoặc lý do hủy đơn @order.Id" />
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@(nextStatuses.Length == 0)">Lưu</button>
                        </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state" style="border:0;background:transparent">
                            <p>Chưa có đơn hàng nào. Đơn mới sẽ xuất hiện ở đây ngay khi khách đặt món.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
