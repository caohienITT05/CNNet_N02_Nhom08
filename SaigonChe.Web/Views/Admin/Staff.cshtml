@model SaigonChe.Web.ViewModels.StaffAccountsViewModel
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h2>Quản Lý Nhân Viên</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Dashboard" class="btn btn-secondary">Dashboard</a>
                <a asp-action="Orders" class="btn btn-secondary">Đơn hàng</a>
            </div>
        </div>

        @if (TempData["AdminSuccess"] is string success)
        {
            <div class="alert alert-success mt-3" role="status">@success</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger mt-3" role="alert">@error</div>
        }

        <section class="dashboard-panel mt-4">
            <h3>Tạo tài khoản nhân viên</h3>
            <p>Tài khoản nhân viên được tạo và cấp quyền bởi quản trị viên.</p>
            <form asp-action="CreateStaff" method="post" class="staff-account-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger validation-errors" role="alert"></div>
                <div>
                    <label asp-for="Email" class="form-label">Email đăng nhập</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Password" class="form-label">Mật khẩu đăng nhập</label>
                    <input name="Password" id="Password" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small class="text-muted">Ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
                </div>
                <button type="submit" class="btn btn-primary align-self-start">Tạo nhân viên</button>
            </form>
        </section>

        <div class="table-responsive mt-4">
            <table class="table table-striped align-middle admin-table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Trạng thái</th>
                        <th>Quyền truy cập</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.Staff)
                    {
                        <tr>
                            <td>@staff.Email</td>
                            <td>@(staff.HasActiveOrders ? "Đang xử lý đơn" : "Sẵn sàng")</td>
                            <td>
                                @if (staff.HasActiveOrders)
                                {
                                    <span class="text-muted">Hoàn tất đơn trước khi gỡ quyền.</span>
                                }
                                else
                                {
                                    <form asp-action="RemoveStaff" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@staff.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Gỡ quyền nhân viên</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Staff.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Chưa có tài khoản nhân viên.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
