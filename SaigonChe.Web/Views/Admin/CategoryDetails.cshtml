@model SaigonChe.Web.ViewModels.CategoryDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h1>@Model.Name</h1>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="EditCategory" asp-route-id="@Model.Id" class="btn btn-primary">Sửa danh mục</a>
                <a asp-action="Categories" class="btn btn-secondary">Danh sách danh mục</a>
            </div>
        </div>

        <p class="mt-3">@Model.Description</p>
        <h2 class="h4 mt-4">Món chè trong danh mục (@Model.Products.Count)</h2>
        @if (Model.Products.Count == 0)
        {
            <p class="text-muted">Danh mục chưa có món chè.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle admin-table">
                    <thead>
                        <tr>
                            <th>Tên món</th>
                            <th>Giá</th>
                            <th>Tình trạng</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("N0")₫</td>
                                <td>@(product.IsAvailable ? "Còn hàng" : "Hết hàng")</td>
                                <td>
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Sửa món</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
