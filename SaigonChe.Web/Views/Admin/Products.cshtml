@model List<SaigonChe.Web.Models.Product>
@{
    ViewData["Title"] = "Món trong thực đơn";
    var available = Model.Count(product => product.IsAvailable);
    var featured = Model.Count(product => product.IsFeatured);
    var hidden = Model.Count - available;
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Thực đơn</span>
        <h1>Món trong thực đơn</h1>
        <p>Quản lý giá, trạng thái và món nổi bật hiển thị trên trang chủ.</p>
    </div>
    <div class="btn-row">
        <a asp-action="CreateProduct" class="btn btn-primary">
            <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
            Thêm món mới
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>Tổng món</span>
        <p class="stat-value">@Model.Count</p>
        <span class="stat-hint">Trong toàn bộ thực đơn</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Đang bán</span>
        <p class="stat-value">@available</p>
        <span class="stat-hint">Hiển thị với khách hàng</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>Nổi bật</span>
        <p class="stat-value">@featured</p>
        <span class="stat-hint">Hiện trong mục best sellers</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>Tạm ẩn</span>
        <p class="stat-value">@hidden</p>
        <span class="stat-hint">Ngừng bán hoặc hết nguyên liệu</span>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="table admin-table">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Tên món</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th>Trạng thái</th>
                <th>Nổi bật</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="admin-thumb" loading="lazy" />
                        }
                        else
                        {
                            <span class="empty-icon" style="width:44px;height:44px;margin:0">
                                <svg class="icon" aria-hidden="true"><use href="#i-leaf" /></svg>
                            </span>
                        }
                    </td>
                    <td>
                        <span class="cell-strong">@product.Name</span>
                        <div class="cell-muted">#@product.Id</div>
                    </td>
                    <td class="cell-muted">@(product.Category?.Name ?? "Chưa phân loại")</td>
                    <td class="cell-mono">@product.Price.ToString("N0")₫</td>
                    <td>
                        @if (product.IsAvailable)
                        {
                            <span class="badge badge-success">Đang bán</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Tạm ẩn</span>
                        }
                    </td>
                    <td>
                        @if (product.IsFeatured)
                        {
                            <span class="badge badge-warning">
                                <svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>
                                Best seller
                            </span>
                        }
                        else
                        {
                            <span class="cell-muted">—</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-secondary btn-sm">Sửa</a>
                            <form asp-action="DeleteProduct" method="post"
                                  data-confirm="Món “@product.Name” sẽ bị xóa hoặc tạm ẩn nếu đã có trong đơn hàng."
                                  data-confirm-title="Xóa món này?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state" style="border:0;background:transparent">
                            <p>Chưa có món nào. Hãy thêm món đầu tiên cho thực đơn.</p>
                            <a asp-action="CreateProduct" class="btn btn-primary">Thêm món mới</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
