@model List<SaigonChe.Web.Models.Product>
@{
    ViewData["Title"] = "Quản trị sản phẩm";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h2>Danh Sách Sản Phẩm</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Categories" class="btn btn-secondary">Danh mục</a>
                <a asp-action="Orders" class="btn btn-secondary">Đơn hàng</a>
                <a asp-action="ContactMessages" class="btn btn-secondary">Liên hệ</a>
                <a asp-action="CreateProduct" class="btn btn-primary">+ Thêm món mới</a>
            </div>
        </div>

        @if (TempData["AdminSuccess"] is string success)
        {
            <div class="alert alert-success mt-3">@success</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger mt-3" role="alert">@error</div>
        }

        <div class="table-responsive mt-4">
            <table class="table table-striped align-middle admin-table">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên món</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Trạng thái</th>
                        <th>Ưu tiên</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="admin-thumb" />
                                }
                            </td>
                            <td>@product.Name</td>
                            <td>@(product.Category?.Name ?? "Chưa phân loại")</td>
                            <td>@product.Price.ToString("N0")₫</td>
                            <td>@(product.IsAvailable ? "Có sẵn" : "Hết món")</td>
                            <td>@(product.IsFeatured ? "Có" : "Không")</td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-secondary btn-sm">Sửa</a>
                                    <form asp-action="DeleteProduct" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xóa món này?')">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
