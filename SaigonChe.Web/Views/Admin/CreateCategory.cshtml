@model SaigonChe.Web.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
}

<section class="section-spacing">
    <div class="container admin-form-wrap">
        <div class="section-heading">
            <span class="eyebrow accent">Quản trị</span>
            <h2>Thêm Danh Mục</h2>
        </div>

        <form asp-action="CreateCategory" method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu danh mục</button>
            <a asp-action="Categories" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
