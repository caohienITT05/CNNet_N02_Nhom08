@model List<SaigonChe.Web.Models.Category>
@{
    ViewData["Title"] = "Danh mục";
    var totalProducts = Model.Sum(category => category.Products.Count);
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Thực đơn</span>
        <h1>Danh mục</h1>
        <p>Nhóm các món chè theo phong cách để khách dễ tìm và lọc.</p>
    </div>
    <div class="btn-row">
        <a asp-action="CreateCategory" class="btn btn-primary">
            <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
            Thêm danh mục
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-tag" /></svg>Danh mục</span>
        <p class="stat-value">@Model.Count</p>
        <span class="stat-hint">Đang dùng trong thực đơn</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>Món đã phân loại</span>
        <p class="stat-value">@totalProducts</p>
        <span class="stat-hint">Trên toàn bộ danh mục</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>Trung bình</span>
        <p class="stat-value">@(Model.Count == 0 ? 0 : Math.Round((double)totalProducts / Model.Count, 1))</p>
        <span class="stat-hint">Món mỗi danh mục</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Trạng thái</span>
        <p class="stat-value">Ổn</p>
        <span class="stat-hint">Không có danh mục trống</span>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="table admin-table">
        <thead>
            <tr>
                <th>Danh mục</th>
                <th>Mô tả</th>
                <th>Số món</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        <span class="cell-strong">@category.Name</span>
                        <div class="cell-muted">#@category.Id</div>
                    </td>
                    <td class="cell-muted contact-message-content">@(string.IsNullOrWhiteSpace(category.Description) ? "Chưa có mô tả" : category.Description)</td>
                    <td>
                        <span class="badge">@category.Products.Count món</span>
                    </td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-secondary btn-sm">Sửa</a>
                            <form asp-action="DeleteCategory" method="post"
                                  data-confirm="Danh mục “@category.Name” chỉ có thể xóa khi không còn món nào."
                                  data-confirm-title="Xóa danh mục?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@category.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="4">
                        <div class="empty-state" style="border:0;background:transparent">
                            <p>Chưa có danh mục nào. Tạo danh mục để bắt đầu sắp xếp thực đơn.</p>
                            <a asp-action="CreateCategory" class="btn btn-primary">Thêm danh mục</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
