@model List<SaigonChe.Web.Models.Category>
@{
    ViewData["Title"] = "Quản trị danh mục";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h2>Danh Mục Sản Phẩm</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Products" class="btn btn-secondary">Sản phẩm</a>
                <a asp-action="Orders" class="btn btn-secondary">Đơn hàng</a>
                <a asp-action="ContactMessages" class="btn btn-secondary">Liên hệ</a>
                <a asp-action="CreateCategory" class="btn btn-primary">+ Thêm danh mục</a>
            </div>
        </div>

        @if (TempData["AdminSuccess"] is string success)
        {
            <div class="alert alert-success mt-3" role="status">@success</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger mt-3" role="alert">@error</div>
        }

        <div class="table-responsive mt-4">
            <table class="table table-striped align-middle admin-table">
                <thead>
                    <tr>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Số sản phẩm</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td>@category.Description</td>
                            <td>@category.Products.Count</td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-secondary btn-sm">Sửa</a>
                                    <form asp-action="DeleteCategory" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@category.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xóa danh mục này?')">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Chưa có danh mục nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
