@model SaigonChe.Web.ViewModels.StaffPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="section container">
    <p class="eyebrow">Quản trị nhân viên</p><h1>Đặt lại mật khẩu</h1>
    <form asp-action="ResetPassword" method="post" class="form-card">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="form-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-primary" type="submit">Đặt lại mật khẩu</button>
        <a class="btn btn-ghost" asp-action="Index">Quay lại</a>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
