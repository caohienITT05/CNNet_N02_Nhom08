@model IReadOnlyList<SaigonChe.Web.ViewModels.StaffRowViewModel>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<section class="section container">
    <div class="section-heading">
        <div><p class="eyebrow">Quản trị</p><h1>Quản lý nhân viên</h1></div>
        <a class="btn btn-primary" asp-action="Create">Tạo tài khoản</a>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var staff in Model)
            {
                <tr>
                    <td>@staff.Email</td>
                    <td>@(staff.IsLocked ? "Đã khóa" : "Đang hoạt động")</td>
                    <td class="d-flex flex-wrap gap-2">
                        <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@staff.Id">Sửa email</a>
                        <a class="btn btn-ghost btn-sm" asp-action="ResetPassword" asp-route-id="@staff.Id">Đặt lại mật khẩu</a>
                        <form asp-action="SetLocked" method="post">
                            <input type="hidden" name="id" value="@staff.Id" />
                            <input type="hidden" name="locked" value="@(!staff.IsLocked)" />
                            <button class="btn btn-ghost btn-sm" type="submit">@(staff.IsLocked ? "Mở khóa" : "Khóa")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-muted">Chưa có tài khoản nhân viên.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
