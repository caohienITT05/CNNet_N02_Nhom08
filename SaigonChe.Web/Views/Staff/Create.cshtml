@model SaigonChe.Web.ViewModels.StaffFormViewModel
@{
    ViewData["Title"] = "Tạo nhân viên";
}

<section class="section container">
    <p class="eyebrow">Quản trị nhân viên</p><h1>Tạo tài khoản nhân viên</h1>
    <form asp-action="Create" method="post" class="form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div>
        <button class="btn btn-primary" type="submit">Tạo nhân viên</button>
        <a class="btn btn-ghost" asp-action="Index">Quay lại</a>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
