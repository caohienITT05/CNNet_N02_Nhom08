@model SaigonChe.Web.ViewModels.StaffOrdersViewModel
@using SaigonChe.Web.Models
@{
    ViewData["Title"] = "Đơn hàng cần xử lý";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Vận hành</span>
                <h2>Đơn Hàng Cần Xử Lý</h2>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">Quản trị</a>
            }
        </div>

        @if (TempData["StaffSuccess"] is string success)
        {
            <div class="alert alert-success mt-3" role="status">@success</div>
        }
        @if (TempData["StaffError"] is string error)
        {
            <div class="alert alert-danger mt-3" role="alert">@error</div>
        }

        <form asp-action="Orders" method="get" class="dashboard-filter mt-4">
            <div>
                <label for="status" class="form-label">Lọc theo trạng thái</label>
                <select id="status" name="status" class="form-select">
                    <option value="">Tất cả đơn</option>
                    @foreach (var status in Html.GetEnumSelectList<OrderStatus>())
                    {
                        var selected = Model.FilterStatus.HasValue
                            && int.TryParse(status.Value, out var statusValue)
                            && (int)Model.FilterStatus.Value == statusValue;
                        <option value="@status.Value" selected="@selected">@status.Text</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Lọc đơn hàng</button>
        </form>

        <div class="table-responsive mt-4">
            <table class="table table-striped align-middle admin-table">
                <thead>
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái / nhân viên</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        var nextStatus = order.Status switch
                        {
                            OrderStatus.Confirmed => OrderStatus.Preparing,
                            OrderStatus.Preparing => OrderStatus.Delivering,
                            OrderStatus.Delivering => OrderStatus.Completed,
                            _ => (OrderStatus?)null
                        };
                        <tr>
                            <td>
                                <details>
                                    <summary>#@order.Id · @order.Items.Count món</summary>
                                    <ul class="mb-2 mt-2 ps-3">
                                        @foreach (var item in order.Items)
                                        {
                                            <li>@item.ProductName × @item.Quantity — @((item.Price * item.Quantity).ToString("N0"))₫</li>
                                        }
                                    </ul>
                                    @if (order.StatusHistory.Count > 0)
                                    {
                                        <strong>Lịch sử trạng thái</strong>
                                        <ul class="mb-0 mt-2 ps-3">
                                            @foreach (var history in order.StatusHistory.OrderByDescending(item => item.ChangedAt))
                                            {
                                                <li>
                                                    @if (history.PreviousStatus.HasValue)
                                                    {
                                                        @Html.DisplayFor(_ => history.PreviousStatus.Value)<span> → </span>
                                                    }
                                                    @Html.DisplayFor(_ => history.Status)
                                                    · @history.ChangedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                                    @if (!string.IsNullOrWhiteSpace(history.ChangedBy))
                                                    {
                                                        <span> · @history.ChangedBy</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(history.Note))
                                                    {
                                                        <span> — @history.Note</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </details>
                            </td>
                            <td>
                                <div>@order.CustomerName</div>
                                <a href="tel:@order.Phone">@order.Phone</a>
                                <small class="d-block text-muted">@order.Address</small>
                            </td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.Total.ToString("N0")₫</td>
                            <td>
                                <div>@Html.DisplayFor(_ => order.Status)</div>
                                @if (order.AssignedStaff != null)
                                {
                                    <small class="text-muted">Phụ trách: @order.AssignedStaff.Email</small>
                                }
                            </td>
                            <td>
                                @if (order.Status == OrderStatus.Pending && order.AssignedStaffId == null)
                                {
                                    <form asp-action="Accept" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">Nhận đơn</button>
                                    </form>
                                }
                                else if (nextStatus.HasValue
                                    && (User.IsInRole("Admin") || order.AssignedStaffId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                                {
                                    <form asp-action="UpdateStatus" method="post" class="staff-order-action">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <input type="hidden" name="status" value="@((int)nextStatus.Value)" />
                                        <input name="note" class="form-control form-control-sm" maxlength="500" placeholder="Ghi chú (không bắt buộc)" aria-label="Ghi chú đơn @order.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            @Html.DisplayFor(_ => nextStatus.Value)
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">Không có thao tác</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không có đơn phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
