@model SaigonChe.Web.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h1>Chi Tiết Khách Hàng</h1>
            </div>
            <a asp-action="Index" class="btn btn-secondary">Danh sách</a>
        </div>

        @if (TempData["CustomerMessage"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        @if (TempData["CustomerError"] is string error)
        {
            <div class="alert alert-warning" role="alert">@error</div>
        }

        <dl class="row customer-details">
            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Số điện thoại</dt>
            <dd class="col-sm-9">@(Model.PhoneNumber ?? "Chưa cập nhật")</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@(Model.IsLocked ? "Đã khóa" : "Đang hoạt động")</dd>
            <dt class="col-sm-3">Đơn hàng</dt>
            <dd class="col-sm-9">@Model.OrderCount</dd>
            <dt class="col-sm-3">Đánh giá</dt>
            <dd class="col-sm-9">@Model.ReviewCount</dd>
        </dl>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa thông tin</a>
            <form asp-action="@(Model.IsLocked ? "Unlock" : "Lock")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-warning">
                    @(Model.IsLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")
                </button>
            </form>
            <form asp-action="Delete" method="post"
                  onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">Xóa tài khoản</button>
            </form>
        </div>
    </div>
</section>
