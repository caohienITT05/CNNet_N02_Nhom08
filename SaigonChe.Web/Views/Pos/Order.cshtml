@model PosOrderViewModel
@{
    ViewData["Title"] = $"Đơn POS #{Model.Order.Id}";
    var order = Model.Order;
    var subtotal = order.Items.Sum(item => item.Price * item.Quantity);
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Vận hành · POS · #@order.Id</span>
        <h1>Đơn POS #@order.Id</h1>
        <p>@(order.Table?.Name ?? "Mang về") · tạo @VietnamTime.ToLocal(order.CreatedAt).ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="btn-row">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
            Danh sách đơn
        </a>
    </div>
</div>

@if (TempData["PosError"] is string error)
{
    <div class="alert alert-danger" role="alert"><span>@error</span></div>
}
@if (TempData["PosSuccess"] is string success)
{
    <div class="alert alert-success" role="status"><span>@success</span></div>
}

<div class="admin-split">
    <div class="admin-stack">
        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Món trong đơn</h2>
                    <p class="panel__sub">Chỉnh số lượng, ghi chú hoặc xóa món khỏi đơn nháp.</p>
                </div>
                <span class="pill pill--muted">@order.Items.Count món</span>
            </div>
            <div class="panel__body" style="padding-top:.4rem;padding-bottom:.4rem">
                @if (order.Items.Count == 0)
                {
                    <p class="empty-state" style="margin:1rem 0;padding:1.5rem">Chưa thêm món.</p>
                }
                @foreach (var item in order.Items.OrderBy(item => item.Id))
                {
                    <form asp-action="UpdateItem" method="post" class="pos-line">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <div class="pos-line__info">
                            <strong>@item.ProductName</strong>
                            <span>@item.Price.ToString("N0") ₫ × @item.Quantity = <strong>@((item.Price * item.Quantity).ToString("N0")) ₫</strong></span>
                        </div>
                        <label class="field">
                            <span class="field__label">SL</span>
                            <input name="quantity" type="number" min="1" max="50" value="@item.Quantity" required class="form-control" />
                        </label>
                        <label class="field">
                            <span class="field__label">Ghi chú</span>
                            <input name="notes" maxlength="500" value="@item.Notes" class="form-control" />
                        </label>
                        <button class="btn btn-secondary btn-sm" type="submit">Lưu</button>
                    </form>
                    <form asp-action="RemoveItem" method="post" class="pos-line__remove">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <button class="btn btn-ghost btn-sm" type="submit">
                            <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
                            Xóa món
                        </button>
                    </form>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Thêm món</h2>
                    <p class="panel__sub">Tìm theo tên hoặc lọc theo danh mục rồi chọn món.</p>
                </div>
            </div>
            <div class="panel__body">
                <div class="field-grid field-grid--2" style="margin-bottom:.8rem">
                    <label class="field">
                        <span class="field__label">Tìm món</span>
                        <input id="posOrderProductSearch" type="search" class="form-control" placeholder="Nhập tên món" />
                    </label>
                    <label class="field">
                        <span class="field__label">Danh mục</span>
                        <select id="posOrderCategoryFilter" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var category in Model.Products.Select(product => product.Category).Where(category => category != null).DistinctBy(category => category!.Id))
                            {
                                <option value="@category!.Id">@category!.Name</option>
                            }
                        </select>
                    </label>
                </div>
                <form asp-action="AddItem" method="post" class="admin-stack">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderId" value="@order.Id" />
                    <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                    <label class="field">
                        <span class="field__label">Món</span>
                        <select id="posOrderProduct" name="ProductId" required class="form-select">
                            <option value="">Chọn món</option>
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id" data-name="@product.Name" data-category="@product.CategoryId">@product.Name · @product.Price.ToString("N0") ₫ @(product.Stock.HasValue ? "(tồn " + product.Stock.Value + ")" : "(chưa khởi tạo tồn)")</option>
                            }
                        </select>
                    </label>
                    <div class="field-grid field-grid--2">
                        <label class="field">
                            <span class="field__label">Số lượng</span>
                            <input type="number" name="Quantity" min="1" max="50" value="1" required class="form-control" />
                        </label>
                        <label class="field">
                            <span class="field__label">Ghi chú</span>
                            <input name="Notes" maxlength="500" placeholder="Ít ngọt, thêm đá…" class="form-control" />
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
                        Thêm vào đơn
                    </button>
                </form>
            </div>
        </section>
    </div>

    <div class="admin-stack">
        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Khách hàng</h2>
                    <p class="panel__sub">Thông tin in trên phiếu thanh toán.</p>
                </div>
            </div>
            <div class="panel__body">
                <form asp-action="Customer" method="post" class="admin-stack">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <div class="field-grid field-grid--2">
                        <label class="field">
                            <span class="field__label">Tên</span>
                            <input name="customerName" maxlength="100" value="@order.CustomerName" required class="form-control" />
                        </label>
                        <label class="field">
                            <span class="field__label">Điện thoại</span>
                            <input name="phone" maxlength="30" value="@order.Phone" required class="form-control" />
                        </label>
                    </div>
                    <label class="field">
                        <span class="field__label">Địa chỉ hoặc bàn</span>
                        <input name="address" maxlength="300" value="@order.Address" required class="form-control" />
                    </label>
                    <button type="submit" class="btn btn-secondary">Lưu thông tin</button>
                </form>
            </div>
        </section>

        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Voucher và thanh toán</h2>
                    <p class="panel__sub">Kiểm tra tổng tiền trước khi xác nhận.</p>
                </div>
            </div>
            <div class="panel__body">
                <form asp-action="Voucher" method="post" class="admin-stack" style="margin-bottom:.9rem">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <label class="field">
                        <span class="field__label">Voucher</span>
                        <select name="voucherId" class="form-select">
                            <option value="">Không áp dụng</option>
                            @foreach (var voucher in Model.Vouchers)
                            {
                                <option value="@voucher.Id" selected="@(order.VoucherId == voucher.Id ? "selected" : null)">@voucher.Code · @voucher.Amount.ToString("N0") @(voucher.Type == VoucherType.Percentage ? "%" : "₫")</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="btn btn-secondary btn-sm">Áp dụng</button>
                </form>

                <div class="summary">
                    <div class="summary__row"><span>Tạm tính</span><strong>@subtotal.ToString("N0") ₫</strong></div>
                    <div class="summary__row"><span>Giảm giá</span><strong>−@order.DiscountAmount.ToString("N0") ₫</strong></div>
                    <div class="summary__row summary__row--total"><span>Khách cần trả</span><strong>@order.Total.ToString("N0") ₫</strong></div>
                </div>

                @if (order.Items.Count == 0)
                {
                    <p class="pos-note" role="status">Đơn chưa có món. Thêm ít nhất một món ở cột bên trái để bật thanh toán.</p>
                }
                @if (Model.VietQrConfigured && !string.IsNullOrWhiteSpace(Model.VietQrUrl))
                {
                    <img class="pos-qr" src="@Model.VietQrUrl" alt="Mã VietQR cho đơn POS #@order.Id" />
                    <p class="pos-note">Quét mã với nội dung <strong>POS @order.Id</strong>. Chỉ xác nhận VietQR sau khi nhân viên đối chiếu tài khoản nhận.</p>
                }

                <form asp-action="Pay" method="post" class="admin-stack" style="margin-top:.9rem" id="posPayForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <label class="field">
                        <span class="field__label">Phương thức</span>
                        <select name="method" id="paymentMethod" class="form-select">
                            <option value="@((int)PaymentMethod.Cash)">Tiền mặt</option>
                            <option value="@((int)PaymentMethod.VietQr)" disabled="@(!Model.VietQrConfigured ? "disabled" : null)">VietQR@(Model.VietQrConfigured ? " · đã nhận tiền" : " · chưa cấu hình")</option>
                        </select>
                    </label>
                    <label class="field" id="cashReceivedField">
                        <span class="field__label">Tiền khách đưa</span>
                        <input type="number" min="@order.Total.ToString("0")" step="1" name="amountReceived" value="@order.Total.ToString("0")" class="form-control" />
                    </label>
                    <button type="submit" class="btn btn-primary btn-block" disabled="@(order.Items.Count == 0 ? "disabled" : null)" onclick="return confirm('Xác nhận đã nhận đủ thanh toán và trừ tồn kho cho đơn này?')">
                        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                        Xác nhận đã nhận thanh toán
                    </button>
                </form>
                <form asp-action="Cancel" method="post" style="margin-top:.6rem" onsubmit="return confirm('Hủy đơn POS chưa thanh toán này?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <button class="btn btn-ghost btn-sm btn-block" type="submit">Hủy đơn nháp</button>
                </form>
            </div>
        </section>
    </div>
</div>

<script>
    (() => { const method = document.getElementById('paymentMethod'); const field = document.getElementById('cashReceivedField'); const update = () => { field.hidden = method.value !== '@((int)PaymentMethod.Cash)'; }; method.addEventListener('change', update); update(); })();
    (() => {
        const search = document.getElementById('posOrderProductSearch');
        const category = document.getElementById('posOrderCategoryFilter');
        const select = document.getElementById('posOrderProduct');
        const filter = () => [...select.options].slice(1).forEach(option => {
            const matchesName = option.dataset.name.toLocaleLowerCase().includes(search.value.trim().toLocaleLowerCase());
            const matchesCategory = !category.value || category.value === option.dataset.category;
            option.hidden = !(matchesName && matchesCategory);
        });
        search.addEventListener('input', filter);
        category.addEventListener('change', filter);
    })();
</script>
