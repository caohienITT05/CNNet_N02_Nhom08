@model PosReceiptViewModel
@{
    ViewData["Title"] = $"Bill POS #{Model.Order.Id}";
    var order = Model.Order;
}
<div class="receipt-page">
    <nav class="receipt-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
            Về bán hàng
        </a>
        <button class="btn btn-primary" type="button" onclick="window.print()">
            <svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>
            In / Lưu PDF
        </button>
    </nav>

    <article class="receipt-paper">
        <p class="receipt-brand">SAIGONCHE</p>
        <p class="receipt-kicker">Phiếu thanh toán tại quầy</p>
        <p class="receipt-meta">
            <strong>Đơn #@order.Id</strong><br />
            @VietnamTime.ToLocal(order.PaidAt ?? order.CreatedAt).ToString("dd/MM/yyyy HH:mm")
        </p>

        <div class="receipt-line"><span>Khách hàng</span><strong>@order.CustomerName</strong></div>
        <div class="receipt-line"><span>Điện thoại</span><strong>@order.Phone</strong></div>
        <div class="receipt-line"><span>Bàn / hình thức</span><strong>@(order.Table?.Name ?? "Mang về")</strong></div>

        @foreach (var item in order.Items)
        {
            <div class="receipt-line">
                <span>
                    @item.ProductName × @item.Quantity
                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <small class="receipt-kicker" style="display:block;text-align:left;margin:.2rem 0 0;letter-spacing:0">@item.Notes</small>
                    }
                </span>
                <strong>@((item.Price * item.Quantity).ToString("N0")) ₫</strong>
            </div>
        }

        <div class="receipt-line"><span>Tạm tính</span><strong>@order.Items.Sum(item => item.Price * item.Quantity).ToString("N0") ₫</strong></div>
        @if (order.Voucher != null)
        {
            <div class="receipt-line"><span>Voucher @order.Voucher.Code</span><strong>−@order.DiscountAmount.ToString("N0") ₫</strong></div>
        }
        <div class="receipt-line receipt-line--total"><span>Đã thanh toán</span><strong>@order.Total.ToString("N0") ₫</strong></div>

        @if (order.PaymentMethod == PaymentMethod.Cash)
        {
            <div class="receipt-line"><span>Khách đưa</span><strong>@Model.AmountReceived.ToString("N0") ₫</strong></div>
            <div class="receipt-line"><span>Tiền thừa</span><strong>@Model.Change.ToString("N0") ₫</strong></div>
        }
        else
        {
            <div class="receipt-line"><span>Thanh toán</span><strong>VietQR · đã xác nhận</strong></div>
        }

        @if (order.PaymentMethod == PaymentMethod.VietQr && !string.IsNullOrWhiteSpace(Model.VietQrUrl))
        {
            <img class="receipt-art" src="@Model.VietQrUrl" alt="Mã VietQR của đơn" />
        }

        <p class="receipt-disclaimer">Phiếu bán hàng nội bộ · Không thay thế hóa đơn điện tử</p>
    </article>
</div>
