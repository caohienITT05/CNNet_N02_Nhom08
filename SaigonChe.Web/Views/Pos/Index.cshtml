@model PosDashboardViewModel
@{
    ViewData["Title"] = "Bán hàng tại quầy";
    var busyTableIds = Model.OpenOrders.Where(order => order.TableId.HasValue).Select(order => order.TableId!.Value).ToHashSet();
}

<div class="admin-page-head pos-hero">
    <div>
        <span class="eyebrow">Vận hành · POS</span>
        <h1>Bán hàng tại quầy</h1>
        <p>Chọn bàn hoặc tạo đơn mang về. Đơn nháp chưa trừ tồn kho.</p>
    </div>
    <div class="btn-row">
        <a class="btn btn-secondary btn-sm" asp-controller="OrderOperations" asp-action="Index">
            <svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>
            Quản lý đơn hàng
        </a>
    </div>
</div>

@if (TempData["PosError"] is string error)
{
    <div class="alert alert-danger" role="alert"><span>@error</span></div>
}
@if (TempData["PosSuccess"] is string success)
{
    <div class="alert alert-success" role="status"><span>@success</span></div>
}

<div class="admin-split">
    <section class="panel">
        <div class="panel__head">
            <div>
                <h2 class="panel__title">Thực đơn đang bán</h2>
                <p class="panel__sub">Bấm “Thêm vào đơn” để đưa món vào đơn đang mở gần nhất của bạn.</p>
            </div>
            <span class="pill">@Model.Products.Count món</span>
        </div>
        <div class="panel__body">
            <div class="pos-toolbar" style="margin-bottom:.85rem">
                <input id="posProductSearch" class="form-control" type="search" placeholder="Tìm món…" aria-label="Tìm món trong thực đơn" />
                <select id="posCategoryFilter" class="form-select" aria-label="Lọc theo danh mục">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="pos-menu" id="posMenu">
                @foreach (var product in Model.Products)
                {
                    <article class="pos-product" data-product-name="@product.Name" data-category-id="@product.CategoryId">
                        <span class="pos-product__name">@product.Name</span>
                        <span class="pos-product__meta">@product.Category?.Name</span>
                        <span class="pos-product__price">@product.Price.ToString("N0") ₫</span>
                        <span class="pos-product__stock">Tồn kho: @(product.Stock.HasValue ? product.Stock.Value.ToString("N0") + " phần" : "chưa khởi tạo")</span>
                        <form asp-action="QuickAdd" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">
                                <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
                                Thêm vào đơn
                            </button>
                        </form>
                    </article>
                }
                @if (Model.Products.Count == 0)
                {
                    <p class="empty-state">Chưa có món đang bán.</p>
                }
            </div>
        </div>
    </section>

    <aside class="admin-stack">
        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Mở đơn mới</h2>
                    <p class="panel__sub">Chọn bàn trống hoặc để trống nếu khách mang về.</p>
                </div>
            </div>
            <div class="panel__body">
                <form asp-action="Start" method="post" class="admin-stack">
                    @Html.AntiForgeryToken()
                    <label class="field">
                        <span class="field__label">Bàn</span>
                        <select id="tableId" name="tableId" class="form-select">
                            <option value="">Mang về</option>
                            @foreach (var table in Model.Tables)
                            {
                                <option value="@table.Id" disabled="@(busyTableIds.Contains(table.Id) ? "disabled" : null)">
                                    @table.Code · @table.Name (@table.Capacity chỗ)@(busyTableIds.Contains(table.Id) ? " — đang có đơn" : "")
                                </option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="btn btn-primary">
                        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
                        Tạo đơn POS
                    </button>
                </form>
                @if (string.IsNullOrWhiteSpace(Model.BankId) || string.IsNullOrWhiteSpace(Model.AccountNumber) || string.IsNullOrWhiteSpace(Model.AccountName))
                {
                    <p class="pos-note">VietQR đang tắt. Tài khoản nhận tiền chưa được thiết lập. Vui lòng liên hệ quản trị viên.</p>
                }
                <p class="pos-note">Tồn kho phải được khởi tạo ở quản trị trước khi thanh toán tại quầy.</p>
            </div>
        </section>

        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Đơn đang mở</h2>
                    <p class="panel__sub">Đơn nháp của bạn và các bàn đang phục vụ.</p>
                </div>
                <span class="pill pill--muted">@Model.OpenOrders.Count đơn</span>
            </div>
            <div class="panel__body">
                @if (Model.OpenOrders.Count == 0)
                {
                    <p class="empty-state" style="padding:1.5rem">Chưa có đơn nháp.</p>
                }
                else
                {
                    <div class="pos-order-list">
                        @foreach (var order in Model.OpenOrders)
                        {
                            <article class="pos-order-row">
                                <div>
                                    <a asp-action="Order" asp-route-id="@order.Id">Đơn #@order.Id</a>
                                    <div class="pos-order-row__meta">@(order.Table?.Name ?? "Mang về") · @order.Items.Sum(item => item.Quantity) phần</div>
                                </div>
                                <div class="pos-order-row__total">
                                    <strong>@order.Total.ToString("N0") ₫</strong>
                                    <span class="pos-order-row__meta">@VietnamTime.ToLocal(order.CreatedAt).ToString("HH:mm")</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    </aside>
</div>

<script>
    (() => {
        const search = document.getElementById('posProductSearch');
        const category = document.getElementById('posCategoryFilter');
        const cards = [...document.querySelectorAll('#posMenu [data-product-name]')];
        const filter = () => cards.forEach(card => {
            const matchesName = card.dataset.productName.toLocaleLowerCase().includes(search.value.trim().toLocaleLowerCase());
            const matchesCategory = !category.value || category.value === card.dataset.categoryId;
            card.hidden = !(matchesName && matchesCategory);
        });
        search.addEventListener('input', filter);
        category.addEventListener('change', filter);
    })();
</script>
