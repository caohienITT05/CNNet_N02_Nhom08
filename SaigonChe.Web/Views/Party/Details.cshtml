@model SaigonChe.Web.ViewModels.PartyRequestDetailsViewModel
@using SaigonChe.Web.Models
@{
    ViewData["Title"] = $"Yêu cầu tiệc #{Model.Id}";
    var localEventAt = VietnamTime.ToLocal(Model.EventAt);
    var terminal = Model.Status is PartyRequestStatus.Cancelled or PartyRequestStatus.Completed;
}

@if (Model.IsStaffView)
{
    <div class="admin-page-head">
        <div>
            <span class="eyebrow">Đặt tiệc · #@Model.Id</span>
            <h1>Chi tiết yêu cầu</h1>
            <p>Trạng thái hiện tại: <strong>@Model.Status.ToDisplayName()</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
            Về hàng đợi
        </a>
    </div>
}
else
{
    <section class="section">
        <div class="container">
            <div class="page-head">
                <span class="eyebrow">Yêu cầu #@Model.Id</span>
                <h1>Chi tiết đặt tiệc</h1>
                <p>Trạng thái: <strong>@Model.Status.ToDisplayName()</strong></p>
            </div>
        </div>
    </section>
}

@if (TempData["PartyError"] is string partyError)
{
    <div class="alert alert-danger" role="alert"><span>@partyError</span></div>
}
@if (TempData["PartySuccess"] is string partySuccess)
{
    <div class="alert alert-success" role="status"><span>@partySuccess</span></div>
}

<div class="@(Model.IsStaffView ? "admin-stack" : "container admin-stack")">
    <section class="panel">
        <div class="panel__head">
            <div>
                <h2 class="panel__title">Thông tin yêu cầu</h2>
                <p class="panel__sub">Thời gian, địa điểm và nhu cầu của khách.</p>
            </div>
            <span class="pill pill--muted">@Model.Status.ToDisplayName()</span>
        </div>
        <div class="panel__body">
            <dl class="party-grid">
                <div><dt>Người liên hệ</dt><dd>@Model.CustomerName</dd></div>
                @if (Model.IsStaffView)
                {
                    <div><dt>Điện thoại</dt><dd>@Model.Phone</dd></div>
                }
                <div><dt>Thời gian</dt><dd>@localEventAt.ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div><dt>Địa điểm</dt><dd>@Model.Location</dd></div>
                <div><dt>Số khách</dt><dd>@Model.Headcount</dd></div>
                @if (Model.QuoteAmount.HasValue)
                {
                    <div><dt>Báo giá</dt><dd>@Model.QuoteAmount.Value.ToString("N0") ₫</dd></div>
                }
                @if (Model.OrderId.HasValue)
                {
                    <div><dt>Đơn hàng</dt><dd>#@Model.OrderId</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="party-notes"><dt>Yêu cầu riêng</dt><dd>@Model.Notes</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Consultation))
                {
                    <div class="party-notes"><dt>Nội dung tư vấn</dt><dd>@Model.Consultation</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                {
                    <div class="party-notes"><dt>Lý do hủy</dt><dd>@Model.CancellationReason</dd></div>
                }
            </dl>
        </div>
    </section>

    <section class="panel">
        <div class="panel__head">
            <div>
                <h2 class="panel__title">Lịch sử trạng thái</h2>
                <p class="panel__sub">Ai đã cập nhật và khi nào.</p>
            </div>
        </div>
        <div class="panel__body">
            @if (Model.StatusHistory.Count == 0)
            {
                <p class="field__hint" style="margin:0">Chưa có cập nhật trạng thái.</p>
            }
            <ol class="party-history">
                @foreach (var entry in Model.StatusHistory)
                {
                    <li>
                        <strong>@entry.Status.ToDisplayName()</strong>
                        <span>@VietnamTime.ToLocal(entry.CreatedAt).ToString("dd/MM/yyyy HH:mm") · @(entry.IsCustomerAction ? "Khách hàng" : "Nhân viên")</span>
                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                        {
                            <p>@entry.Note</p>
                        }
                    </li>
                }
            </ol>
        </div>
    </section>

    @if (Model.IsStaffView && !terminal)
    {
        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">Cập nhật yêu cầu</h2>
                    <p class="panel__sub">Chuyển trạng thái, báo giá và chốt món cho đơn tiệc.</p>
                </div>
            </div>
            <div class="panel__body">
                <form asp-action="Update" method="post" class="admin-stack">
                    <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    }

                    <div class="field-grid field-grid--2">
                        <label class="field" for="status">
                            <span class="field__label">Trạng thái tiếp theo</span>
                            <select class="form-select" name="Status" id="status" required>
                                @if (Model.Status == PartyRequestStatus.Pending)
                                {
                                    <option value="InProgress">Đang xử lý</option>
                                }
                                @if (Model.Status == PartyRequestStatus.InProgress)
                                {
                                    <option value="Confirmed">Đã xác nhận và tạo đơn</option>
                                }
                                @if (Model.Status == PartyRequestStatus.Confirmed)
                                {
                                    <option value="Completed">Hoàn thành</option>
                                }
                                <option value="Cancelled">Hủy yêu cầu</option>
                            </select>
                        </label>
                        <label class="field" for="quoteAmount">
                            <span class="field__label">Báo giá (₫)</span>
                            <input class="form-control" type="number" min="0" step="1000" id="quoteAmount" name="QuoteAmount" value="@Model.QuoteAmount" />
                        </label>
                    </div>

                    <label class="field" for="consultation">
                        <span class="field__label">Tư vấn / ghi chú cho khách</span>
                        <textarea class="form-control" rows="3" maxlength="2000" id="consultation" name="Consultation">@Model.Consultation</textarea>
                    </label>

                    <label class="field" for="cancellationReason">
                        <span class="field__label">Lý do hủy</span>
                        <input class="form-control" id="cancellationReason" name="CancellationReason" maxlength="500" value="@Model.CancellationReason" />
                        <span class="field__hint">Bắt buộc khi chọn hủy yêu cầu.</span>
                    </label>

                    @if (Model.Status == PartyRequestStatus.InProgress)
                    {
                        <fieldset class="party-products">
                            <legend>Chọn món cho đơn đã chốt</legend>
                            @if (Model.Products.Count == 0)
                            {
                                <p class="field__hint">Chưa có món nào đang bán.</p>
                            }
                            @for (var i = 0; i < Model.Products.Count; i++)
                            {
                                var product = Model.Products[i];
                                var selected = Model.SelectedLines.FirstOrDefault(line => line.ProductId == product.Id);
                                <div class="party-product-row">
                                    <input type="hidden" name="Lines[@i].ProductId" value="@product.Id" />
                                    <label><input type="checkbox" name="Lines[@i].Selected" value="true" checked="@(selected?.Selected ?? false)" /> @product.Name · @product.Price.ToString("N0") ₫</label>
                                    <input aria-label="Số lượng @product.Name" class="form-control" type="number" min="0" max="10000" name="Lines[@i].Quantity" value="@(selected?.Quantity ?? 0)" />
                                </div>
                            }
                            <p class="field__hint">Giá và trạng thái món được kiểm tra lại từ cơ sở dữ liệu khi xác nhận.</p>
                        </fieldset>
                    }

                    @if (Model.Status == PartyRequestStatus.Confirmed)
                    {
                        <label class="field" for="paymentMethod">
                            <span class="field__label">Thanh toán khi hoàn tất</span>
                            <select name="PaymentMethod" id="paymentMethod" class="form-select">
                                <option value="">Chọn phương thức</option>
                                <option value="Cash">Tiền mặt</option>
                                @if (Model.VietQrUrl is not null)
                                {
                                    <option value="VietQr">VietQR (đã xác nhận nhận tiền)</option>
                                }
                            </select>
                            <span asp-validation-for="PaymentMethod" class="field__hint text-danger"></span>
                        </label>
                        @if (Model.VietQrUrl is not null)
                        {
                            <div class="party-qr">
                                <p class="field__hint">Khách chuyển đúng giá báo. Nhân viên chỉ chọn VietQR sau khi xác nhận đã nhận tiền.</p>
                                <img src="@Model.VietQrUrl" alt="Mã QR thanh toán đơn tiệc @Model.OrderId" />
                            </div>
                        }
                        else
                        {
                            <p class="field__hint">Chưa cấu hình VietQR; có thể ghi nhận thanh toán tiền mặt.</p>
                        }
                    }

                    <button type="submit" class="btn btn-primary">Lưu cập nhật</button>
                </form>
            </div>
        </section>
    }
    else if (!Model.IsStaffView)
    {
        <div>
            <a asp-action="MyRequests" class="btn btn-secondary">
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
                Quay lại yêu cầu của tôi
            </a>
        </div>
    }
</div>
