@model IReadOnlyList<SaigonChe.Web.ViewModels.PartyRequestQueueRowViewModel>
@{
    ViewData["Title"] = User.IsInRole("Admin") || User.IsInRole("Staff") ? "Yêu cầu đặt tiệc" : "Yêu cầu của tôi";
    var staffView = User.IsInRole("Admin") || User.IsInRole("Staff");
}

@if (staffView)
{
    <div class="admin-page-head"><div><span class="eyebrow">Đặt tiệc</span><h1>Hàng đợi yêu cầu</h1><p>Tiếp nhận yêu cầu, lưu nội dung tư vấn, báo giá và theo dõi đơn tiệc.</p></div></div>
    <section class="report-table-card">
        <div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Điện thoại</th><th>Thời gian</th><th>Địa điểm</th><th>Số khách</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @if (Model.Count == 0) { <tr><td colspan="8">Chưa có yêu cầu đặt tiệc.</td></tr> }
        @foreach (var request in Model)
        {
            <tr><td>#@request.Id</td><td>@request.CustomerName</td><td>@request.Phone</td><td>@VietnamTime.ToLocal(request.EventAt).ToString("dd/MM/yyyy HH:mm")</td><td>@request.Location</td><td>@request.Headcount</td><td>@request.Status.ToDisplayName()</td><td><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@request.Id">Mở</a></td></tr>
        }
        </tbody></table></div>
    </section>
}
else
{
    <section class="section"><div class="container">
        <div class="page-head"><span class="eyebrow">Sự kiện của tôi</span><h1>Yêu cầu đặt tiệc</h1><p>Theo dõi tư vấn, báo giá và trạng thái các yêu cầu của bạn.</p><a asp-action="Create" class="btn btn-primary">Gửi yêu cầu mới</a></div>
        <div class="report-table-card"><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã</th><th>Ngày tổ chức</th><th>Địa điểm</th><th>Số khách</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @if (Model.Count == 0) { <tr><td colspan="6">Bạn chưa gửi yêu cầu đặt tiệc.</td></tr> }
        @foreach (var request in Model)
        {
            <tr><td>#@request.Id</td><td>@VietnamTime.ToLocal(request.EventAt).ToString("dd/MM/yyyy HH:mm")</td><td>@request.Location</td><td>@request.Headcount</td><td>@request.Status.ToDisplayName()</td><td><a asp-action="Details" asp-route-id="@request.Id">Xem chi tiết</a></td></tr>
        }
        </tbody></table></div></div>
    </div></section>
}
