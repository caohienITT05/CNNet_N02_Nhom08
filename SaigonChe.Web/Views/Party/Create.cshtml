@model SaigonChe.Web.ViewModels.PartyRequestCreateViewModel
@{
    ViewData["Title"] = "Yêu cầu đặt tiệc";
}

<section class="section">
    <div class="container">
        <div class="page-head">
            <span class="eyebrow">Sự kiện của bạn</span>
            <h1>Gửi yêu cầu đặt tiệc</h1>
            <p>Chia sẻ thời gian, địa điểm và số khách. Nhân viên sẽ liên hệ tư vấn và báo giá.</p>
        </div>
        <div class="checkout-card party-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="form-group"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" maxlength="100" required /><span asp-validation-for="CustomerName" class="text-danger small"></span></div>
                <div class="form-group"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" maxlength="30" autocomplete="tel" required /><span asp-validation-for="Phone" class="text-danger small"></span></div>
                <div class="form-group"><label asp-for="EventAt" class="form-label"></label><input asp-for="EventAt" type="datetime-local" class="form-control" required /><span asp-validation-for="EventAt" class="text-danger small"></span></div>
                <div class="form-group"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" maxlength="300" required /><span asp-validation-for="Location" class="text-danger small"></span></div>
                <div class="form-group"><label asp-for="Headcount" class="form-label"></label><input asp-for="Headcount" type="number" min="1" max="10000" class="form-control" required /><span asp-validation-for="Headcount" class="text-danger small"></span></div>
                <div class="form-group"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="4" maxlength="2000" placeholder="Món muốn đặt, thời gian giao, dị ứng hoặc yêu cầu chuẩn bị riêng"></textarea><span asp-validation-for="Notes" class="text-danger small"></span></div>
                <div class="form-actions"><button type="submit" class="btn btn-primary">Gửi yêu cầu</button><a asp-action="MyRequests" class="btn btn-ghost">Theo dõi yêu cầu</a></div>
            </form>
        </div>
    </div>
</section>
