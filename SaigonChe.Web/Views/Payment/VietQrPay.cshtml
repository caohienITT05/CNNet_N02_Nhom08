@model SaigonChe.Web.ViewModels.VietQrPaymentViewModel

@{
    ViewData["Title"] = "Quét mã VietQR - Quán Chè Sài Gòn";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="mb-3">
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> Cổng thanh toán VietQR Napas247
                    </span>
                </div>

                <h4 class="fw-bold text-danger mb-1">Mã Đơn: @Model.OrderCode</h4>
                <p class="text-muted small">Mở app Ngân hàng hoặc MoMo quét mã QR bên dưới</p>

                <!-- Ảnh QR Động sinh ra từ VietQrService -->
                <div class="p-3 bg-light rounded-4 my-3 d-inline-block shadow-sm">
                    <img src="@Model.QrImageUrl" alt="VietQR Code" class="img-fluid rounded-3"
                         style="max-width: 290px;" />
                </div>

                <div class="bg-light p-3 rounded-3 text-start small mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Ngân hàng:</span>
                        <strong class="text-dark">@Model.BankId</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Số tài khoản:</span>
                        <strong class="text-dark">@Model.AccountNo</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Chủ tài khoản:</span>
                        <strong class="text-dark">@Model.AccountName</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Số tiền:</span>
                        <strong class="text-danger fs-6">@Model.FinalAmount.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Nội dung CK:</span>
                        <strong class="text-primary font-monospace">@Model.OrderCode</strong>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-center text-muted small mb-3" id="waitingBox">
                    <div class="spinner-border spinner-border-sm text-danger me-2" role="status"></div>
                    <span>Hệ thống đang chờ nhận tiền tự động...</span>
                </div>

                <a href="/Order/Tracking?orderCode=@Model.OrderCode"
                   class="btn btn-outline-secondary rounded-pill btn-sm">
                    Để sau / Tra cứu đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Microsoft SignalR từ CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const orderCode = "@Model.OrderCode";

        // Khởi tạo kết nối tới Hub SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/paymentHub")
            .withAutomaticReconnect()
            .build();

        // Lắng nghe sự kiện "PaymentSuccess" từ server
        connection.on("PaymentSuccess", function (res) {
            $('#waitingBox').html('<div class="alert alert-success py-2 w-100 fw-bold">Thanh toán thành công! Đang chuyển hướng...</div>');
            setTimeout(function () {
                window.location.href = '/Order/Success?orderCode=' + orderCode;
            }, 1500);
        });

        // Bắt đầu kết nối và join vào room đơn hàng
        connection.start().then(function () {
            connection.invoke("JoinOrderGroup", orderCode).catch(err => console.error(err));
        }).catch(err => console.error("SignalR Connection Error: ", err));
    </script>
}