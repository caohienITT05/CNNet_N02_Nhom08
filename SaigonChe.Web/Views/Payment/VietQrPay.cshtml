@model SaigonChe.Web.ViewModels.VietQrPaymentViewModel

@{
    ViewData["Title"] = "Quét mã VietQR";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="mb-3">
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                        <svg class="icon me-1" aria-hidden="true"><use href="#i-shield" /></svg> Cổng thanh toán VietQR Napas247
                    </span>
                </div>

                <h1 class="h4 fw-bold text-danger mb-1 text-break">Mã đơn @Model.OrderCode</h1>
                <p class="text-muted small">Mở app Ngân hàng hoặc MoMo quét mã QR bên dưới</p>

                <!-- Ảnh QR Động sinh ra từ VietQrService -->
                <div class="p-3 bg-light rounded-4 my-3 d-inline-block shadow-sm">
                    <img src="@Model.QrImageUrl" alt="Mã VietQR của đơn @Model.OrderCode" class="img-fluid rounded-3"
                         style="width: min(290px, 100%);" />
                </div>

                <div class="bg-light p-3 rounded-3 text-start small mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Ngân hàng:</span>
                        <strong class="text-dark">@Model.BankId</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Số tài khoản:</span>
                        <strong class="text-dark">@Model.AccountNo</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Chủ tài khoản:</span>
                        <strong class="text-dark text-end text-break ms-2">@Model.AccountName</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Số tiền:</span>
                        <strong class="text-danger fs-6">@Model.FinalAmount.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Nội dung CK:</span>
                        <strong class="text-primary font-monospace text-end text-break ms-2">@Model.OrderCode</strong>
                    </div>
                </div>

                <div class="text-muted small mb-3" id="waitingBox" role="status">
                    Đang chờ xác nhận chuyển khoản. Bạn có thể theo dõi trạng thái trong trang tra cứu đơn hàng.
                </div>

                <a asp-controller="Order" asp-action="Tracking" asp-route-orderCode="@Model.OrderCode"
                   class="btn btn-outline-secondary rounded-pill btn-sm">
                    Tra cứu đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Microsoft SignalR từ CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const orderCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderCode));

        if (window.signalR) {
            const connection = new signalR.HubConnectionBuilder()
            .withUrl("/paymentHub")
            .withAutomaticReconnect()
            .build();

            connection.on("PaymentSuccess", function () {
                document.getElementById('waitingBox').textContent = 'Đã xác nhận thanh toán. Đang mở thông tin đơn hàng.';
                setTimeout(function () {
                    window.location.href = '/Order/Success?orderCode=' + encodeURIComponent(orderCode);
                }, 1500);
            });

            const joinOrder = () => connection.invoke("JoinOrderGroup", orderCode).catch(console.error);
            connection.onreconnected(joinOrder);
            connection.start().then(joinOrder).catch(console.error);
        }
    </script>
}
