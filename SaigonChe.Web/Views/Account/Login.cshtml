@model SaigonChe.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Description"] = "Đăng nhập Chè Sài Gòn để đặt món và theo dõi đơn hàng của bạn.";
}

<section class="auth-section login-section" aria-labelledby="login-title">
    <div class="container">
        <div class="auth-card">
            <aside class="auth-aside login-aside">
                <span class="login-brand">Chè Sài Gòn</span>
                <div class="login-aside-copy">
                    <span class="eyebrow light">Chè ba màu</span>
                    <p>Chọn món chè yêu thích và theo dõi đơn hàng ngay trong tài khoản của bạn.</p>
                </div>
            </aside>

            <div class="auth-form-panel">
                <div class="auth-form-heading">
                    <span class="eyebrow">Chào mừng bạn trở lại</span>
                    <h1 id="login-title">Đăng nhập</h1>
                    <p>Nhập email và mật khẩu để tiếp tục.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-validation" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="ban@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="password-field">
                            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                            <button type="button" id="login-password-toggle" class="password-toggle" aria-controls="Password" aria-label="Hiện mật khẩu" hidden>Hiện</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check auth-remember">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary auth-submit">
                        Đăng nhập
                    </button>
                </form>

                <p class="auth-switch">
                    Chưa có tài khoản?
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
                </p>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const loginPassword = document.getElementById('Password');
        const loginPasswordToggle = document.getElementById('login-password-toggle');

        loginPasswordToggle.hidden = false;
        loginPasswordToggle.addEventListener('click', () => {
            const showPassword = loginPassword.type === 'password';
            loginPassword.type = showPassword ? 'text' : 'password';
            loginPasswordToggle.textContent = showPassword ? 'Ẩn' : 'Hiện';
            loginPasswordToggle.setAttribute('aria-label', showPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
        });
    </script>
}
