@model List<SaigonChe.Web.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Product API";
    var available = Model.Count(product => product.IsAvailable);
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Kênh thử nghiệm</span>
        <h1>Món qua Web API</h1>
        <p>Danh sách này lấy trực tiếp từ <span class="cell-mono">/api/products</span> của SaigonChe.Api.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Create" class="btn btn-primary">
            <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
            Thêm món
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>Tổng món</span>
        <p class="stat-value">@Model.Count</p>
        <span class="stat-hint">Từ API</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Còn bán</span>
        <p class="stat-value">@available</p>
        <span class="stat-hint">Đang hiển thị</span>
    </div>
    <div class="stat-card">
        <span class="stat-label"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>Hết hàng</span>
        <p class="stat-value">@(Model.Count - available)</p>
        <span class="stat-hint">Cần bổ sung</span>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="table admin-table">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Tên món</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="admin-thumb" loading="lazy" />
                        }
                        else
                        {
                            <span class="cell-muted">Chưa có ảnh</span>
                        }
                    </td>
                    <td>
                        <span class="cell-strong">@product.Name</span>
                        <div class="cell-muted">#@product.Id</div>
                    </td>
                    <td class="cell-muted">@(string.IsNullOrWhiteSpace(product.CategoryName) ? "Chưa phân loại" : product.CategoryName)</td>
                    <td class="cell-mono">@product.Price.ToString("N0")₫</td>
                    <td class="cell-muted contact-message-content">@product.Description</td>
                    <td>
                        @if (product.IsAvailable)
                        {
                            <span class="badge badge-success">Còn hàng</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Hết hàng</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-secondary btn-sm">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post"
                                  data-confirm="Món “@product.Name” sẽ bị xóa khỏi hệ thống API."
                                  data-confirm-title="Xóa món này?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state" style="border:0;background:transparent">
                            <p>API chưa trả về món nào.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
