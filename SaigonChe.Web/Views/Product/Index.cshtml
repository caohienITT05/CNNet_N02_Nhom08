@model List<SaigonChe.Web.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Danh sách món chè";
}

<div class="container mt-4">

    <h1 class="mb-4">Quán Chè SG</h1>

    <h3>Danh sách món chè</h3>

    <a asp-controller="Product"
       asp-action="Create"
       class="btn btn-primary mb-3">
       + Thêm món chè
       </a>

    <table class="table table-bordered table-striped mt-3">

        <thead>
            <tr>
                <th>ID</th>
                <th>Ảnh</th>
                <th>Tên món</th>
                <th>Giá</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.Name"
                                 width="80"
                                 height="80"
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <span>Chưa có ảnh</span>
                        }
                    </td>

                    <td>@product.Name</td>

                    <td>
                        @product.Price.ToString("N0") đ
                    </td>

                    <td>@product.Description</td>

                    <td>
                        @if (product.IsAvailable)
                        {
                            <span class="badge bg-success">
                                Còn hàng
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Hết hàng
                            </span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Product"
                            asp-action="Edit"
                            asp-route-id="@product.Id"
                            class="btn btn-warning btn-sm">Sửa</a>
                    </td>
                    <td>
                        <form asp-controller="Product"
                            asp-action = "Delete"
                            asp-route-id ="@product.Id"
                            method = "post"
                            style ="display:inline;"
                            onsubmit="return confirm('Bạn có chắc chắn muốn xóa món này không?');">
                                <button type="submit" class = "btn btn-danger btn-sm">Xóa</button>
                            </form>
                            
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>