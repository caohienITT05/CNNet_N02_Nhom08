@model SaigonChe.Web.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Sửa món qua API";
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Product API</span>
        <h1>Sửa món qua API</h1>
        <p>Thay đổi được gửi tới <span class="cell-mono">PUT /api/products/@Model.Id</span>.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Index" class="btn btn-ghost">Quay lại</a>
    </div>
</div>

<div class="admin-form-wrap">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="ImageUrl" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger auth-validation" role="alert"></div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="image-preview">
                <img src="@Model.ImageUrl" alt="@Model.Name" />
                <p>Ảnh hiện tại. Chọn ảnh mới nếu muốn thay thế.</p>
            </div>
        }

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name" class="form-label">Tên món</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="form-label">Giá (VNĐ)</label>
                <input asp-for="Price" type="number" min="0" step="1000" class="form-control" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile" class="form-label">Chọn ảnh mới</label>
                <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                <small class="form-text">Để trống nếu muốn giữ ảnh hiện tại.</small>
                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="form-check">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label">Còn hàng</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
