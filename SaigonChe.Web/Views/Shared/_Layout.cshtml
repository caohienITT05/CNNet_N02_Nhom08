@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@using SaigonChe.Web.Models
@using SaigonChe.Web.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isHomePage = controller == "Home" && action == "Index";
    var isAdminSection = controller is "Admin" or "Product" or "Category";
    var homeUrl = Url.Action("Index", "Home") ?? "/";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var accountName = User.Identity?.Name ?? string.Empty;
    var displayName = accountName.Contains('@') ? accountName.Split('@')[0] : accountName;
    var initials = string.IsNullOrWhiteSpace(displayName)
        ? "CS"
        : (displayName.Length >= 2 ? displayName[..2] : displayName).ToUpperInvariant();

    var cartJson = Context.Session.GetString("Cart");
    var cartCount = 0;
    if (!string.IsNullOrWhiteSpace(cartJson))
    {
        try
        {
            var cartItems = JsonSerializer.Deserialize<List<CartItemViewModel>>(cartJson);
            cartCount = cartItems?.Sum(item => item.Quantity) ?? 0;
        }
        catch
        {
            cartCount = 0;
        }
    }

    string SectionHref(string anchor) => isHomePage ? $"#{anchor}" : $"{homeUrl}#{anchor}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Chè Sài Gòn – Ngọt ngào hương vị Việt. Thực đơn chè truyền thống và hiện đại, ưu đãi hấp dẫn, phong cách Sài Gòn.")" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>@ViewData["Title"] – Chè Sài Gòn</title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem("csg-theme");
                document.documentElement.setAttribute("data-theme", saved === "light" ? "light" : "dark");
            } catch (error) {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(isAdminSection ? "admin-body" : "site-body") @ViewData["BodyClass"]">
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
