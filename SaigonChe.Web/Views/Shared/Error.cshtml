@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<section class="status-section">
    <div class="container">
        <div class="status-card">
            <span class="status-icon" aria-hidden="true">
                <svg class="icon" style="width:22px;height:22px"><use href="#i-alert" /></svg>
            </span>
            <span class="eyebrow">Đã có lỗi xảy ra</span>
            <h1>Ly chè này bị đổ mất rồi.</h1>
            <p>
                Chúng tôi không thể xử lý yêu cầu của bạn ngay lúc này. Vui lòng thử lại,
                hoặc quay về trang chủ để tiếp tục chọn món.
            </p>

            @if (Model.ShowRequestId)
            {
                <span class="status-code">
                    Mã yêu cầu: <code>@Model.RequestId</code>
                </span>
            }

            <div class="status-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    Về trang chủ
                    <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline">Xem giỏ hàng</a>
            </div>
        </div>
    </div>
</section>
