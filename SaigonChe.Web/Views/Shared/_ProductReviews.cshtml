@model SaigonChe.Web.ViewModels.ProductReviewsViewModel

<section class="product-reviews section-spacing" id="reviews">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow accent">Cảm nhận khách hàng</span>
            <h2>Đánh Giá Món Chè</h2>
            @if (Model.ReviewCount > 0)
            {
                <p class="review-summary">
                    <strong>@Model.AverageRating.ToString("0.0") / 5</strong>
                    <span aria-label="@Model.AverageRating.ToString("0.0") trên 5 sao">★</span>
                    (@Model.ReviewCount đánh giá)
                </p>
            }
            else
            {
                <p>Chưa có đánh giá cho món chè này.</p>
            }
        </div>

        @if (TempData["ReviewSuccess"] is string reviewSuccess)
        {
            <div class="alert alert-success" role="status">@reviewSuccess</div>
        }
        @if (TempData["ReviewError"] is string reviewError)
        {
            <div class="alert alert-danger" role="alert">@reviewError</div>
        }

        @if (Model.IsAuthenticated)
        {
            var currentReview = Model.CurrentUserReview;
            <div class="review-form-card">
                <h3>@(currentReview == null ? "Viết đánh giá" : "Cập nhật đánh giá của bạn")</h3>
                <form asp-controller="Review"
                      asp-action="@(currentReview == null ? "Create" : "Update")"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductId" value="@Model.ProductId" />
                    @if (currentReview?.ReviewId is int reviewId)
                    {
                        <input type="hidden" name="ReviewId" value="@reviewId" />
                    }
                    <fieldset class="mb-3">
                        <legend class="form-label">Chọn số sao</legend>
                        <div class="review-rating-options">
                            @for (var rating = 5; rating >= 1; rating--)
                            {
                                <label>
                                    <input type="radio" name="Rating" value="@rating"
                                           checked="@(currentReview?.Rating == rating)" required />
                                    @rating ★
                                </label>
                            }
                        </div>
                    </fieldset>
                    <div class="mb-3">
                        <label for="reviewComment" class="form-label">Bình luận</label>
                        <textarea id="reviewComment" name="Comment" class="form-control" rows="4"
                                  maxlength="1000" required>@currentReview?.Comment</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        @(currentReview == null ? "Gửi đánh giá" : "Lưu thay đổi")
                    </button>
                </form>
                @if (currentReview?.ReviewId is int currentReviewId)
                {
                    <form asp-controller="Review" asp-action="Delete" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@currentReviewId" />
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <button type="submit" class="btn btn-link text-danger">Xóa đánh giá của tôi</button>
                    </form>
                }
            </div>
        }
        else
        {
            <p><a asp-controller="Account" asp-action="Login"
                  asp-route-returnUrl="@Url.Action("Details", "Menu", new { id = Model.ProductId })">Đăng nhập</a> để viết đánh giá.</p>
        }

        @if (Model.Reviews.Count > 0)
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="review-card">
                        <div class="review-card-heading">
                            <strong>@review.UserName</strong>
                            <time datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</time>
                        </div>
                        <div class="stars" aria-label="@review.Rating trên 5 sao">
                            @for (var star = 0; star < review.Rating; star++)
                            {
                                <span>★</span>
                            }
                        </div>
                        <p>@review.Comment</p>
                        @if (!string.IsNullOrWhiteSpace(review.AdminReply))
                        {
                            <div class="admin-review-reply">
                                <strong>Phản hồi từ quán</strong>
                                <p>@review.AdminReply</p>
                                @if (review.RepliedAt.HasValue)
                                {
                                    <time datetime="@review.RepliedAt.Value.ToString("O")">@review.RepliedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</time>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>
