@model SaigonChe.Web.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = "Sửa danh mục qua API";
}

<div class="admin-page-head">
    <div>
        <span class="eyebrow">Category API</span>
        <h1>Sửa danh mục qua API</h1>
        <p>Thay đổi được gửi tới <span class="cell-mono">PUT /api/categories/@Model.Id</span>.</p>
    </div>
    <div class="btn-row">
        <a asp-action="Index" class="btn btn-ghost">Quay lại</a>
    </div>
</div>

<div class="admin-form-wrap">
    <form asp-action="Edit" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-validation" role="alert"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label">Tên danh mục</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
