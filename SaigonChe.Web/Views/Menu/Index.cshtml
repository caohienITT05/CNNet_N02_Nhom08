@model SaigonChe.Web.ViewModels.MenuIndexViewModel
@{
    ViewData["Title"] = "Thực đơn";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<section class="section-spacing menu-page">
    <div class="container">
        <div class="section-heading text-center">
            <span class="eyebrow accent">Chè Sài Gòn</span>
            <h1>Thực Đơn Chè</h1>
            <p>Chọn món chè yêu thích, xem tình trạng phục vụ và tìm món phù hợp với bạn.</p>
        </div>

        <form asp-action="Index" method="get" class="menu-filter-panel">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label for="Search" class="form-label">Tìm theo tên món</label>
                    <input id="Search" name="Search" value="@Model.Search" class="form-control"
                           placeholder="Ví dụ: chè đậu xanh" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label asp-for="MinPrice" class="form-label">Giá từ</label>
                    <input asp-for="MinPrice" type="number" min="0" max="1000000" step="1000" class="form-control" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label asp-for="MaxPrice" class="form-label">Giá đến</label>
                    <input asp-for="MaxPrice" type="number" min="0" max="1000000" step="1000" class="form-control" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="Status" class="form-label">Tình trạng</label>
                    <select asp-for="Status" class="form-select">
                        <option value="all">Tất cả</option>
                        <option value="available">Còn hàng</option>
                        <option value="unavailable">Hết hàng</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="Sort" class="form-label">Sắp xếp</label>
                    <select asp-for="Sort" class="form-select">
                        <option value="name">Tên A–Z</option>
                        <option value="price-asc">Giá thấp đến cao</option>
                        <option value="price-desc">Giá cao đến thấp</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <button type="submit" class="btn btn-primary w-100">Lọc thực đơn</button>
                </div>
                <div class="col-lg-3 col-md-6">
                    <a asp-action="Index" class="btn btn-secondary w-100">Xóa bộ lọc</a>
                </div>
            </div>
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-warning mt-3" role="alert"></div>
        }

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-4">
            <p class="mb-0">Tìm thấy @Model.TotalProducts món, trang @Model.Page / @Model.TotalPages.</p>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="empty-state">
                <p>Không tìm thấy món chè phù hợp với bộ lọc hiện tại.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.Products)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="menu-card menu-list-card">
                            <div class="card-image-wrap">
                                <a asp-action="Details" asp-route-id="@item.Id" aria-label="Xem chi tiết @item.Name">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/menu/che-ba-mau.jpg" : item.ImageUrl)"
                                         alt="@item.Name" loading="lazy" />
                                </a>
                                @if (item.IsFeatured)
                                {
                                    <span class="menu-label">Bán chạy</span>
                                }
                                <span class="availability-label @(item.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsAvailable ? "Còn hàng" : "Hết hàng")
                                </span>
                                <form asp-controller="Favorite" asp-action="Toggle" method="post" class="favorite-toggle-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="favorite-toggle-button @(item.IsFavorite ? "is-favorite" : string.Empty)"
                                            aria-label="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")"
                                            aria-pressed="@item.IsFavorite" title="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")">
                                        <span aria-hidden="true">@(item.IsFavorite ? "♥" : "♡")</span>
                                    </button>
                                </form>
                            </div>
                            <div class="card-body">
                                <div class="card-head">
                                    <h2><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h2>
                                    <span class="price">@item.Price.ToString("N0")₫</span>
                                </div>
                                <p>@item.Description</p>
                                <div class="menu-card-actions">
                                    <span class="category-tag">@item.CategoryName</span>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <button type="submit" class="btn btn-primary" disabled="@(!item.IsAvailable)">
                                            @(item.IsAvailable ? "Thêm vào giỏ" : "Hết hàng")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Phân trang thực đơn" class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.Page ? "active" : string.Empty)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-status="@Model.Status"
                                   asp-route-sort="@Model.Sort"
                                   asp-route-page="@pageNumber">@pageNumber</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</section>
