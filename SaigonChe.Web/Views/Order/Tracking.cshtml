@using SaigonChe.Web.Models
@model List<Order>

@{
    ViewData["Title"] = "Tra cứu đơn hàng";
    var steps = new (OrderStatus Status, string Label, string Icon)[]
    {
        (OrderStatus.Pending, "Chờ xác nhận", "receipt"),
        (OrderStatus.Confirmed, "Đã xác nhận", "check"),
        (OrderStatus.Preparing, "Đang chuẩn bị", "cup"),
        (OrderStatus.Shipping, "Đang giao", "truck"),
        (OrderStatus.Completed, "Đã nhận chè", "home")
    };
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-danger">Tra Cứu Đơn Hàng</h2>
        <p class="text-muted">Nhập mã đơn hàng hoặc số điện thoại đặt chè để kiểm tra lộ trình giao hàng.</p>
        
        <form method="get" class="row justify-content-center g-2 mt-3">
            <div class="col-md-4">
                <label for="tracking-code" class="visually-hidden">Mã đơn hàng</label>
                <input id="tracking-code" type="text" name="orderCode" value="@Context.Request.Query["orderCode"]"
                       class="form-control rounded-pill px-4" placeholder="Nhập mã đơn (VD: TF2026...)" />
            </div>
            <div class="col-md-3">
                <label for="tracking-phone" class="visually-hidden">Số điện thoại</label>
                <input id="tracking-phone" type="tel" name="phone" value="@Context.Request.Query["phone"]"
                       class="form-control rounded-pill px-4" placeholder="Hoặc số điện thoại..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-danger w-100 rounded-pill fw-semibold">
                    <svg class="icon me-1" aria-hidden="true"><use href="#i-search" /></svg> Tra cứu
                </button>
            </div>
        </form>
    </div>

    @if (Model != null)
    {
        if (!Model.Any())
        {
            <div class="alert alert-warning text-center rounded-4">
                Không tìm thấy đơn hàng nào phù hợp với thông tin tra cứu.
            </div>
        }
        else
        {
            foreach (var order in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <h5 class="fw-bold text-danger mb-0">Đơn hàng: #@order.OrderCode</h5>
                            <small class="text-muted">Ngày đặt: @VietnamTime.ToLocal(order.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div>
                            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                                @Html.DisplayFor(_ => order.Status)
                            </span>
                        </div>
                    </div>

                    @if (order.Status == OrderStatus.Cancelled)
                    {
                        <p class="alert alert-secondary">Đơn hàng đã hủy.</p>
                    }
                    else
                    {
                        var status = order.Status == OrderStatus.Delivering ? OrderStatus.Shipping : order.Status;
                        var currentStep = Array.FindIndex(steps, step => step.Status == status);
                        <ol class="row row-cols-2 row-cols-sm-5 g-3 text-center my-3 list-unstyled" aria-label="Tiến trình đơn hàng">
                            @for (var index = 0; index < steps.Length; index++)
                            {
                                var step = steps[index];
                                <li class="col @(index <= currentStep ? "text-success" : "text-muted")" aria-current="@(index == currentStep ? "step" : null)">
                                    <svg class="icon fs-3" aria-hidden="true"><use href="#i-@step.Icon" /></svg>
                                    <div class="small fw-bold">@step.Label</div>
                                </li>
                            }
                        </ol>
                    }

                    <div class="bg-light rounded-3 p-3 mt-2">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Người nhận:</strong> @order.CustomerName</p>
                                <p class="mb-1"><strong>SĐT:</strong> @order.Phone</p>
                                <p class="mb-0"><strong>Địa chỉ:</strong> @order.Address</p>
                            </div>
                            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                <p class="mb-1"><strong>Hình thức:</strong> @order.PaymentMethod.ToString()</p>
                                <p class="mb-1"><strong>Thanh toán:</strong> <span class="badge bg-info text-dark">@order.PaymentStatus.ToString()</span></p>
                                <p class="mb-0"><strong>Tổng tiền:</strong> <span class="fs-5 fw-bold text-danger">@order.Total.ToString("N0") đ</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>
