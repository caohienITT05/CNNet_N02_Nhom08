@model SaigonChe.Web.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="mb-3">
                    <svg class="icon text-success" style="font-size: 4rem;" aria-hidden="true"><use href="#i-check" /></svg>
                </div>
                <h3 class="fw-bold text-dark mb-1">Đặt Hàng Thành Công!</h3>
                <p class="text-muted">Cảm ơn bạn đã ủng hộ Quán Chè Sài Gòn. Đơn hàng đang được chuẩn bị.</p>

                <div class="bg-light p-4 rounded-3 text-start mb-4">
                    <p class="mb-1"><strong>Mã đơn hàng:</strong> <span
                        class="text-danger fw-bold font-monospace">@Model.OrderCode</span></p>
                        <p class="mb-1"><strong>Người nhận:</strong> @Model.CustomerName (@Model.Phone)</p>
                        <p class="mb-1"><strong>Địa chỉ giao:</strong> @Model.Address</p>
                        <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod.ToString()</p>
                        <p class="mb-0"><strong>Trạng thái thanh toán:</strong>
                            <span
                                class="badge @(Model.PaymentStatus == SaigonChe.Web.Models.PaymentStatus.Paid ? "bg-success" : "bg-warning")">
                                @Model.PaymentStatus.ToString()
                            </span>
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Order/Tracking?orderCode=@Model.OrderCode"
                           class="btn btn-outline-danger w-50 rounded-pill">
                            Theo dõi đơn hàng
                        </a>
                        <a href="/" class="btn btn-danger w-50 rounded-pill">
                            Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>