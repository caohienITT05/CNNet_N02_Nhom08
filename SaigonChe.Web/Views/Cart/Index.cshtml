@model SaigonChe.Web.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
    var itemCount = Model.Items.Sum(item => item.Quantity);
}

<section class="section">
    <div class="container">
        <div class="page-head">
            <span class="eyebrow">Giỏ hàng</span>
            <h1>Đơn hàng của bạn</h1>
            <p>@(Model.Items.Any() ? $"{itemCount} phần chè đang chờ được giao đến bạn." : "Chưa có món nào trong giỏ.")</p>
        </div>

        @if (TempData["CartError"] is string cartError)
        {
            <div class="alert alert-warning" role="alert">@cartError</div>
        }

        @if (TempData["CartSuccess"] is string cartSuccess)
        {
            <div class="alert alert-success" role="status">@cartSuccess</div>
        }

        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <span class="empty-icon">
                    <svg class="icon" aria-hidden="true"><use href="#i-cart" /></svg>
                </span>
                <h2>Giỏ hàng đang trống</h2>
                <p>Hãy chọn vài ly chè yêu thích — chúng tôi sẽ chuẩn bị và giao ngay khi bạn xác nhận.</p>
                <a asp-controller="Home" asp-action="Index" asp-fragment="menu" class="btn btn-primary">
                    Khám phá thực đơn
                    <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <div class="cart-items">
                    @foreach (var item in Model.Items)
                    {
                        <article class="cart-item" id="cart-row-@item.ProductId">
                            <div class="cart-thumb">
                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/default-che.jpg" : item.ImageUrl)"
                                     alt="@item.Name" loading="lazy" />
                            </div>

                            <div class="cart-details">
                                <h4>@item.Name</h4>
                                <p>@item.Price.ToString("N0")₫ / ly</p>
                            </div>

                            <div class="cart-qty-form">
                                <div class="qty-stepper">
                                    <button type="button" data-qty-minus aria-label="Giảm số lượng @item.Name"
                                            onclick="updateQty(@item.ProductId, -1)">
                                        <svg class="icon" aria-hidden="true"><use href="#i-minus" /></svg>
                                    </button>
                                    <label class="sr-only" for="qty-@item.ProductId">Số lượng @item.Name</label>
                                    <input id="qty-@item.ProductId" type="number" value="@item.Quantity"
                                           min="1" max="20" readonly />
                                    <button type="button" data-qty-plus aria-label="Tăng số lượng @item.Name"
                                            onclick="updateQty(@item.ProductId, 1)">
                                        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
                                    </button>
                                </div>
                            </div>

                            <span class="cart-total" id="item-total-@item.ProductId">@item.LineTotal.ToString("N0")₫</span>

                            <button type="button" class="remove-btn" aria-label="Xóa @item.Name khỏi giỏ hàng"
                                    title="Xóa món" onclick="removeItem(@item.ProductId)">
                                <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
                            </button>
                        </article>
                    }

                    <div>
                        <a asp-controller="Home" asp-action="Index" asp-fragment="menu" class="btn btn-ghost btn-sm">
                            <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                            Tiếp tục chọn món
                        </a>
                    </div>
                </div>

                <aside class="cart-summary">
                    <h4>Tóm tắt đơn hàng</h4>

                    <form id="couponForm" class="mb-3">
                        @Html.AntiForgeryToken()
                        <label for="couponCodeInput" class="form-label">Mã giảm giá / ưu đãi</label>
                        <div class="input-group">
                            <input type="text" id="couponCodeInput" class="form-control text-uppercase"
                                   placeholder="Nhập mã ưu đãi..." value="@Model.CouponCode" />
                            <button class="btn btn-dark" type="submit">Áp dụng</button>
                        </div>
                        <div id="couponMessage" class="small mt-2" role="status"></div>
                    </form>

                    <div class="summary-row">
                        <span>Tạm tính (@itemCount phần)</span>
                        <strong id="cartSubTotal">@Model.SubTotal.ToString("N0")₫</strong>
                    </div>
                    <div class="summary-row">
                        <span>Mã giảm giá</span>
                        <strong id="cartDiscount">-@Model.DiscountAmount.ToString("N0")₫</strong>
                    </div>
                    <div class="summary-row total-row">
                        <span>Thành tiền</span>
                        <strong id="cartFinalTotal">@Model.FinalTotal.ToString("N0")₫</strong>
                    </div>

                    <div class="summary-content">
                        <p>
                            <svg class="icon" aria-hidden="true"><use href="#i-truck" /></svg>
                            Miễn phí giao hàng nội thành cho đơn từ 150.000₫.
                        </p>
                        <p>
                            <svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg>
                            Chọn thanh toán COD hoặc VietQR ở bước tiếp theo.
                        </p>
                    </div>

                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary" style="width:100%">
                        Tiến hành đặt món
                        <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                    </a>
                </aside>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        const antiForgeryToken = document.querySelector('#couponForm input[name="__RequestVerificationToken"]')?.value;

        function updateSummary(response) {
            if (response.subTotal) $('#cartSubTotal').text(response.subTotal);
            if (response.discountAmount) $('#cartDiscount').text('-' + response.discountAmount);
            if (response.finalTotal) $('#cartFinalTotal').text(response.finalTotal);
        }

        function updateQty(productId, delta) {
            const input = $('#qty-' + productId);
            const quantity = parseInt(input.val(), 10) + delta;
            if (quantity <= 0) {
                removeItem(productId);
                return;
            }

            $.post('/Cart/Update', {
                productId: productId,
                quantity: quantity,
                __RequestVerificationToken: antiForgeryToken
            }, function (response) {
                if (!response.success) {
                    alert(response.message);
                    return;
                }

                input.val(quantity);
                $('#item-total-' + productId).text(response.itemTotalPrice);
                updateSummary(response);
                if (response.totalItems === 0) location.reload();
            });
        }

        function removeItem(productId) {
            if (!confirm('Bạn có chắc chắn muốn xóa món này?')) return;

            $.post('/Cart/Remove', {
                productId: productId,
                __RequestVerificationToken: antiForgeryToken
            }, function (response) {
                if (!response.success) {
                    alert(response.message);
                    return;
                }

                $('#cart-row-' + productId).fadeOut(250, function () {
                    $(this).remove();
                    if (response.totalItems === 0) {
                        location.reload();
                        return;
                    }
                    updateSummary(response);
                });
            });
        }

        $('#couponForm').on('submit', function (event) {
            event.preventDefault();
            const code = $('#couponCodeInput').val().trim();
            if (!code) {
                $('#couponMessage').removeClass('text-success').addClass('text-danger')
                    .text('Vui lòng điền mã.');
                return;
            }

            $.post('/Cart/ApplyCoupon', {
                couponCode: code,
                __RequestVerificationToken: antiForgeryToken
            }, function (response) {
                const message = $('#couponMessage');
                if (response.success) {
                    message.removeClass('text-danger').addClass('text-success').text(response.message);
                    updateSummary(response);
                } else {
                    message.removeClass('text-success').addClass('text-danger').text(response.message);
                }
            });
        });
    </script>
}
