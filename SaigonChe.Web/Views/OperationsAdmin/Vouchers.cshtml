@model IReadOnlyList<SaigonChe.Web.Models.Voucher>
@{ ViewData["Title"] = "Voucher"; }
<div class="admin-page-head"><div><span class="eyebrow">Khuyến mãi</span><h1>Voucher</h1><p>Mỗi đơn POS sử dụng tối đa một mã còn hiệu lực.</p></div><a asp-action="CreateVoucher" class="btn btn-primary">Tạo voucher</a></div>
<div class="admin-table-wrap"><table class="table admin-table"><thead><tr><th>Mã</th><th>Loại giảm</th><th>Giá trị</th><th>Thời hạn</th><th>Lượt dùng</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td><strong>@item.Code</strong></td><td>@(item.Type == SaigonChe.Web.Models.VoucherType.Percentage ? "Phần trăm" : "Số tiền")</td><td>@(item.Type == SaigonChe.Web.Models.VoucherType.Percentage ? $"{item.Amount:N0}%" : $"{item.Amount:N0} ₫")</td><td>@item.ValidFrom.ToString("dd/MM/yyyy") – @item.ValidTo.ToString("dd/MM/yyyy")</td><td>@item.UseCount / @(item.UseLimit?.ToString() ?? "∞")</td><td>@(item.IsActive ? "Đang hoạt động" : "Đã tắt")</td><td><div class="d-flex gap-2"><a asp-action="EditVoucher" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Sửa</a><form asp-action="ToggleVoucher" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button class="btn btn-secondary btn-sm" type="submit">@(item.IsActive ? "Tắt" : "Bật")</button></form></div></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7">Chưa có voucher.</td></tr> }
</tbody></table></div>
