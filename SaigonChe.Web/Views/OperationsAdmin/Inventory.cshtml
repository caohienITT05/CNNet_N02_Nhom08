@model IReadOnlyList<SaigonChe.Web.ViewModels.InventoryAdminViewModel>
@{ ViewData["Title"] = "Tồn kho món"; }
<div class="admin-page-head"><div><span class="eyebrow">Quản lý kho</span><h1>Tồn kho món</h1><p>Nhập số lượng ban đầu, bổ sung hoặc điều chỉnh tồn. Mọi thay đổi được lưu lịch sử.</p></div></div>
<div class="admin-table-wrap"><table class="table admin-table"><thead><tr><th>Món</th><th>Tồn hiện tại</th><th>Thay đổi (+/-)</th><th>Lý do</th><th></th></tr></thead><tbody>
@foreach (var product in Model)
{
<tr><td>@product.ProductName</td><td>@(product.Stock?.ToString() ?? "Chưa thiết lập")</td><td colspan="3"><form asp-action="AdjustStock" method="post" class="d-flex gap-2 flex-wrap">@Html.AntiForgeryToken()<input type="hidden" name="ProductId" value="@product.ProductId"/><input class="form-control" type="number" name="QuantityChange" min="-10000" max="10000" required aria-label="Thay đổi số lượng"/><input class="form-control" name="Reason" maxlength="100" required placeholder="Lý do" aria-label="Lý do điều chỉnh"/><button class="btn btn-secondary btn-sm" type="submit">Cập nhật</button></form></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5">Chưa có món trong thực đơn.</td></tr> }
</tbody></table></div>
