@model SaigonChe.Web.ViewModels.VoucherFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Tạo voucher" : "Sửa voucher"; }
<section class="section container voucher-editor">
<div class="admin-page-head"><div><span class="eyebrow">Khuyến mãi</span><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="SaveVoucher" method="post" class="form-card">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Code" class="form-label">Mã voucher</label><input asp-for="Code" class="form-control" maxlength="40"/><span asp-validation-for="Code" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Type" class="form-label">Loại</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<SaigonChe.Web.Models.VoucherType>()" class="form-select"></select></div>
<div class="mb-3"><label asp-for="Amount" class="form-label">Giá trị giảm</label><input asp-for="Amount" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ValidFrom" class="form-label">Từ ngày</label><input asp-for="ValidFrom" type="date" class="form-control"/></div><div class="mb-3"><label asp-for="ValidTo" class="form-label">Đến ngày</label><input asp-for="ValidTo" type="date" class="form-control"/></div>
<div class="mb-3"><label asp-for="MinimumOrderTotal" class="form-label">Giá trị đơn tối thiểu</label><input asp-for="MinimumOrderTotal" class="form-control"/></div><div class="mb-3"><label asp-for="UseLimit" class="form-label">Giới hạn lượt dùng (để trống nếu không giới hạn)</label><input asp-for="UseLimit" class="form-control"/></div>
@if (Model.Id > 0) { <input asp-for="UseCount" type="hidden"/> }
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Đang hoạt động</label></div>
<div class="form-actions">
    <button class="btn btn-primary" type="submit">Lưu voucher</button>
    <a asp-action="Vouchers" class="btn btn-secondary">Quay lại</a>
</div>
</form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
