@model IReadOnlyList<SaigonChe.Web.Models.DiningTable>
@{ ViewData["Title"] = "Quản lý bàn"; }
<section class="section container" aria-label="@ViewData["Title"]">
    <partial name="_AdminFeedback" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<div class="admin-page-head"><div><span class="eyebrow">POS</span><h1>Quản lý bàn</h1><p>Mỗi bàn chỉ nhận một đơn đang mở. Bàn ngừng hoạt động sẽ không xuất hiện trong POS.</p></div></div>
<section class="form-card mb-4">
    <h2 class="h4">Thêm bàn</h2>
    <form asp-action="SaveDiningTable" method="post" class="dining-create">
        <input type="hidden" name="Id" value="0" />
        <input type="hidden" name="IsActive" value="true" />
        <label>Mã bàn<input class="form-control" name="Code" maxlength="30" required placeholder="Ví dụ: B01" /></label>
        <label>Tên bàn<input class="form-control" name="Name" maxlength="80" required placeholder="Ví dụ: Bàn 1" /></label>
        <label>Sức chứa<input class="form-control" type="number" name="Capacity" min="1" max="100" value="4" required /></label>
        <button class="btn btn-primary" type="submit">Thêm bàn</button>
    </form>
</section>
<div class="admin-table-wrap operations-table">
    <table class="table admin-table">
        <thead><tr><th>Mã</th><th>Tên bàn</th><th>Sức chứa</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var table in Model)
        {
            var formId = $"table-{table.Id}";
            <tr>
                <td><input form="@formId" class="form-control" name="Code" maxlength="30" value="@table.Code" required aria-label="Mã bàn @table.Name" /></td>
                <td><input form="@formId" class="form-control" name="Name" maxlength="80" value="@table.Name" required aria-label="Tên bàn @table.Name" /></td>
                <td><input form="@formId" class="form-control operations-number" type="number" name="Capacity" min="1" max="100" value="@table.Capacity" required aria-label="Sức chứa @table.Name" /></td>
                <td><span class="badge @(table.IsActive ? "text-bg-success" : "text-bg-secondary")">@(table.IsActive ? "Đang dùng" : "Đã ẩn")</span></td>
                <td>
                    <div class="d-flex flex-wrap gap-2">
                        <form id="@formId" asp-action="SaveDiningTable" method="post">
                            <input type="hidden" name="Id" value="@table.Id" />
                            <input type="hidden" name="IsActive" value="@table.IsActive" />
                            <button class="btn btn-secondary btn-sm" type="submit">Lưu</button>
                        </form>
                        <form asp-action="ToggleDiningTable" method="post">
                            <input type="hidden" name="id" value="@table.Id" />
                            <button class="btn btn-outline btn-sm" type="submit">@(table.IsActive ? "Ngừng" : "Kích hoạt")</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5">Chưa có bàn phục vụ.</td></tr> }
        </tbody>
    </table>
</div>
</section>
