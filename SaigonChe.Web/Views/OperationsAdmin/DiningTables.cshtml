@model IReadOnlyList<SaigonChe.Web.Models.DiningTable>
@{ ViewData["Title"] = "Quản lý bàn"; }
<div class="admin-page-head"><div><span class="eyebrow">POS</span><h1>Quản lý bàn</h1><p>Mỗi bàn chỉ nhận một đơn đang mở. Bàn ngừng hoạt động sẽ không xuất hiện trong POS.</p></div></div>
<section class="report-table-card"><h2>Thêm bàn</h2><form asp-action="SaveDiningTable" method="post" class="d-flex gap-2 flex-wrap">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="0"/><input class="form-control" name="Code" maxlength="30" required placeholder="Mã bàn"/><input class="form-control" name="Name" maxlength="80" required placeholder="Tên bàn"/><input class="form-control" type="number" name="Capacity" min="1" max="100" value="4" required aria-label="Sức chứa"/><input type="hidden" name="IsActive" value="true"/><button class="btn btn-primary" type="submit">Thêm bàn</button></form></section>
<div class="admin-table-wrap"><table class="table admin-table"><thead><tr><th>Mã</th><th>Tên bàn</th><th>Sức chứa</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var table in Model)
{
<tr><td colspan="4"><form asp-action="SaveDiningTable" method="post" class="d-flex gap-2 flex-wrap">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@table.Id"/><input class="form-control" name="Code" maxlength="30" value="@table.Code" required/><input class="form-control" name="Name" maxlength="80" value="@table.Name" required/><input class="form-control" type="number" name="Capacity" min="1" max="100" value="@table.Capacity" required/><input type="hidden" name="IsActive" value="@table.IsActive"/><button class="btn btn-secondary btn-sm" type="submit">Lưu</button></form></td><td><span class="badge @(table.IsActive ? "badge-success" : "badge-secondary")">@(table.IsActive ? "Đang dùng" : "Đã ẩn")</span><form asp-action="ToggleDiningTable" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@table.Id"/><button class="btn btn-secondary btn-sm" type="submit">@(table.IsActive ? "Ngừng" : "Kích hoạt")</button></form></td></tr>
}
</tbody></table></div>
