@model List<SaigonChe.Web.ViewModels.FavoriteProductViewModel>
@{
    ViewData["Title"] = "Món yêu thích của tôi";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<section class="section-spacing">
    <div class="container">
        <div class="section-heading text-center">
            <span class="eyebrow accent">Danh sách của bạn</span>
            <h1>Món Yêu Thích Của Tôi</h1>
        </div>

        @if (TempData["FavoriteMessage"] is string favoriteMessage)
        {
            <div class="alert alert-success" role="status">@favoriteMessage</div>
        }

        @if (TempData["CartError"] is string cartError)
        {
            <div class="alert alert-warning" role="alert">@cartError</div>
        }

        @if (TempData["CartSuccess"] is string cartSuccess)
        {
            <div class="alert alert-success" role="status">@cartSuccess</div>
        }

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <p>Bạn chưa có món chè yêu thích nào. Hãy khám phá thực đơn nhé!</p>
                <a asp-controller="Home" asp-action="Index" asp-fragment="menu" class="btn btn-primary">Khám phá thực đơn</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="menu-card favorite-card">
                            <div class="card-image-wrap">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                }
                                <span class="availability-label @(item.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsAvailable ? "Còn hàng" : "Hết hàng")
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="card-head">
                                    <h2>@item.Name</h2>
                                    <span class="price">@item.Price.ToString("N0")₫</span>
                                </div>
                                <p class="favorite-category">@item.CategoryName</p>
                                <div class="favorite-actions">
                                    <form asp-controller="Favorite" asp-action="Toggle" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-outline-danger">Bỏ yêu thích</button>
                                    </form>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-primary" disabled="@(!item.IsAvailable)">
                                            @(item.IsAvailable ? "Thêm vào giỏ" : "Hết hàng")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
