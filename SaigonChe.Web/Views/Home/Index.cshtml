@model SaigonChe.Web.ViewModels.LandingPageViewModel
@using SaigonChe.Web.Models
@{
    ViewData["Title"] = "Trang chủ";
}

<section id="home" class="hero-section section-spacing">
    <div class="container">
        @if (TempData["OrderSuccess"] is string orderSuccess)
        {
            <div class="alert alert-success" role="status">
                @orderSuccess
                @if (TempData["OrderId"] is int orderId)
                {
                    <strong>Mã đơn hàng: #@orderId</strong>
                }
            </div>
        }

        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-copy">
                <span class="eyebrow accent">Chè Việt · Thủ công mỗi ngày</span>
                <h1>Ngọt ngào từ Sài Gòn</h1>
                <p>
                    Từ ly chè ba màu quen thuộc đến những món tráng miệng hiện đại, mỗi phần chè đều được nấu
                    thủ công bằng nguyên liệu tươi, công thức gia truyền và sự tận tâm của người Sài Gòn.
                </p>
                <div class="hero-actions">
                    <a href="#menu" class="btn btn-primary btn-lg">
                        Khám phá thực đơn
                        <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                    </a>
                    <a href="#about" class="btn btn-outline btn-lg">Câu chuyện của quán</a>
                </div>
                <div class="hero-badges">
                    <span>Nguyên liệu chọn lọc</span>
                    <span>Chế biến mỗi ngày</span>
                    <span>Hương vị Việt</span>
                </div>
                <div class="hero-meta mt-3">
                    <div class="stars" aria-label="Đánh giá 4.9 trên 5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>
                        }
                    </div>
                    <span>4.9/5 từ hơn 1.200 thực khách</span>
                </div>
            </div>
            <div class="col-lg-6 hero-visual">
                <div class="image-card main-card">
                    <img src="/images/menu/che-ba-mau.jpg"
                         alt="Chè ba màu nhiều tầng thạch, đậu và nước cốt dừa" fetchpriority="high" />
                </div>
                <div class="floating-badge badge-one">
                    <strong>Vị Việt</strong>
                    <small>Ngọt ngào thân quen</small>
                </div>
                <div class="floating-badge badge-two">
                    <strong>Đang mở cửa</strong>
                    <small>Giao nhanh trong 30 phút</small>
                </div>
            </div>
        </div>
        <ul class="hero-note">
            <li><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Nguyên liệu tươi mỗi ngày</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Không chất bảo quản</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Giao nhanh trong 30 phút</li>
        </ul>
    </div>
</section>

<div class="trust-strip">
    <div class="container">
        <div class="trust-strip__inner">
            <span class="trust-strip__label">Được tin chọn bởi</span>
            <ul class="trust-items">
                <li><svg class="icon" aria-hidden="true"><use href="#i-user" /></svg>12.000+ khách hàng</li>
                <li><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>4.9/5 đánh giá</li>
                <li><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>Giao trong 30 phút</li>
                <li><svg class="icon" aria-hidden="true"><use href="#i-leaf" /></svg>100% nguyên liệu tươi</li>
            </ul>
        </div>
    </div>
</div>

<section id="about" class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow">Về Chè Sài Gòn</span>
                <h2>Hương vị Sài Gòn trong từng ly chè</h2>
                <p class="section-lead">
                    Ba thế hệ giữ lửa bếp chè, chúng tôi vẫn nấu từng nồi chè theo cách cũ: chậm rãi,
                    tỉ mỉ và không bỏ qua bất kỳ nguyên liệu nào.
                </p>
            </div>
            <a class="btn btn-outline" href="#menu">
                Xem thực đơn
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
            </a>
        </div>

        <div class="bento">
            <article class="bento-main" data-reveal>
                <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80"
                     alt="Không gian quán chè ấm cúng" loading="lazy" />
                <div class="bento-main__content">
                    <span class="badge">Từ 1998</span>
                    <h3>Một góc nhỏ Sài Gòn, giữ trọn vị xưa</h3>
                    <p>
                        Bắt đầu từ chiếc xe chè nhỏ trên hẻm, đến nay quán vẫn giữ công thức gia truyền
                        và cách nấu thủ công như ngày đầu.
                    </p>
                </div>
            </article>

            <article class="bento-card" data-reveal>
                <span class="feature-icon"><svg class="icon" aria-hidden="true"><use href="#i-leaf" /></svg></span>
                <h3>Nguyên liệu chọn lọc</h3>
                <p>Đậu, khoai, dừa và hạt sen được chọn từ nông trại quen thuộc, nhập mới mỗi sáng.</p>
                <span class="mono">Tươi mỗi ngày</span>
            </article>

            <article class="bento-card" data-reveal>
                <span class="feature-icon"><svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg></span>
                <h3>Nấu chậm, giữ vị</h3>
                <p>Mỗi nồi chè được nấu riêng, vị ngọt thanh từ đường mía thay vì đường tinh luyện.</p>
                <span class="mono">Công thức 1998</span>
            </article>

            <article class="bento-card" data-reveal>
                <span class="feature-icon"><svg class="icon" aria-hidden="true"><use href="#i-truck" /></svg></span>
                <h3>Giao nhanh nội thành</h3>
                <p>Đóng gói giữ lạnh, giao trong 30 phút để ly chè vẫn tròn vị như vừa nấu xong.</p>
                <span class="mono">30 phút</span>
            </article>

            <article class="bento-card" data-reveal>
                <span class="feature-icon"><svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg></span>
                <h3>An toàn vệ sinh</h3>
                <p>Bếp mở, nguyên liệu có nguồn gốc rõ ràng và quy trình kiểm soát từng ngày.</p>
                <span class="mono">Đạt chuẩn</span>
            </article>
        </div>

        <div class="steps" style="margin-top:1rem">
            <article class="step-card" data-reveal>
                <span class="step-index">01</span>
                <h3>Chọn món yêu thích</h3>
                <p>Duyệt thực đơn theo danh mục, tìm nhanh bằng từ khóa và thêm vào giỏ chỉ với một cú nhấp.</p>
            </article>
            <article class="step-card" data-reveal>
                <span class="step-index">02</span>
                <h3>Điền thông tin giao hàng</h3>
                <p>Thanh toán đơn giản, xác nhận đơn ngay trên màn hình và theo dõi trạng thái chuẩn bị.</p>
            </article>
            <article class="step-card" data-reveal>
                <span class="step-index">03</span>
                <h3>Thưởng thức ngay</h3>
                <p>Chè được đóng gói cẩn thận, giao tận nơi trong 30 phút, giữ nguyên hương vị tươi mát.</p>
            </article>
        </div>
    </div>
</section>

<section class="weather-recommendation section-spacing">
    <div class="container">
        <div class="section-heading text-center">
            <span class="eyebrow accent">Món ngon theo thời tiết</span>
            <h2>Hôm Nay Ăn Chè Gì?</h2>
            <p>Chọn thời tiết hiện tại để xem những món chè phù hợp nhất.</p>
        </div>
        <form asp-controller="Home" asp-action="Index" method="get" class="weather-selector">
            <label for="weather" class="form-label">Thời tiết chỗ bạn</label>
            <select id="weather" name="weather" class="form-select">
                <option value="">Chọn thời tiết</option>
                @foreach (var condition in Html.GetEnumSelectList<WeatherCondition>())
                {
                    var selected = Model.SelectedWeather.HasValue
                        && int.TryParse(condition.Value, out var weatherValue)
                        && (int)Model.SelectedWeather.Value == weatherValue;
                    <option value="@condition.Value" selected="@selected">@condition.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Gợi ý món</button>
        </form>

        @if (Model.SelectedWeather.HasValue)
        {
            <p class="weather-description text-center mt-3" role="status">@Model.WeatherDescription</p>
            @if (Model.WeatherRecommendations.Count > 0)
            {
                <div class="row g-4 mt-2">
                    @foreach (var item in Model.WeatherRecommendations)
                    {
                        <div class="col-md-6 col-lg-4">
                            <article class="menu-card weather-card">
                                <div class="card-image-wrap">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">
                                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">
                                            <img src="/images/menu/che-ba-mau.jpg" alt="@item.Name" loading="lazy" />
                                        </a>
                                    }
                                    <form asp-controller="Favorite" asp-action="Toggle" method="post" class="favorite-toggle-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <button type="submit" class="favorite-toggle-button @(item.IsFavorite ? "is-favorite" : string.Empty)"
                                                aria-label="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")"
                                                aria-pressed="@item.IsFavorite" title="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")">
                                            <span aria-hidden="true">@(item.IsFavorite ? "♥" : "♡")</span>
                                        </button>
                                    </form>
                                </div>
                                <div class="card-body">
                                    <div class="card-head">
                                        <h4><a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h4>
                                        <span class="price">@item.Price.ToString("N0")₫</span>
                                    </div>
                                    <p>@item.Description</p>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <button type="submit" class="btn btn-primary">Đặt món</button>
                                    </form>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="empty-menu-message">Hiện chưa có món phù hợp trong thực đơn.</p>
            }
        }
    </div>
</section>

<section id="menu" class="menu-section section-spacing section-muted">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow">Thực đơn</span>
                <h2>Món ngon đang chờ bạn</h2>
                <p class="section-lead">Chọn theo khẩu vị, tìm nhanh món yêu thích hoặc để chúng tôi gợi ý món bán chạy nhất hôm nay.</p>
            </div>
            <div class="menu-toolbar">
                <div class="search-field">
                    <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                    <label for="menuSearch" class="sr-only">Tìm món chè</label>
                    <input id="menuSearch" class="form-control" type="search"
                           placeholder="Tìm theo tên hoặc nguyên liệu…" autocomplete="off"
                           aria-describedby="menuResultCount" />
                    <kbd>Ctrl K</kbd>
                </div>
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-pills" role="group" aria-label="Bộ lọc món ăn">
                @foreach (var filter in Model.Categories)
                {
                    var filterValue = filter switch
                    {
                        "Chè truyền thống" => "traditional",
                        "Chè hiện đại" => "modern",
                        "Món bán chạy" => "featured",
                        _ => "all"
                    };
                    <button type="button" class="filter-btn @(filterValue == "all" ? "active" : string.Empty)"
                            data-filter="@filterValue" aria-pressed="@(filterValue == "all" ? "true" : "false")">
                        @filter
                    </button>
                }
            </div>
            <span id="menuResultCount" class="menu-result-count" aria-live="polite"></span>
        </div>

        <div class="product-grid">
            @foreach (var item in Model.Products)
            {
                <div class="menu-card-wrapper"
                     data-category="@item.CategoryTag"
                     data-featured="@(item.IsFeatured ? "featured" : "normal")"
                     data-search="@($"{item.Name} {item.Description} {item.CategoryName}")"
                     data-reveal>
                    <article class="product-card">
                        <div class="product-media">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">
                                    <img src="/images/menu/che-ba-mau.jpg" alt="@item.Name" loading="lazy" />
                                </a>
                            }
                            <div class="product-badges">
                                @if (item.IsFeatured)
                                {
                                    <span class="menu-label">
                                        <svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>
                                        Bán chạy
                                    </span>
                                }
                                <span class="product-cat">@item.CategoryName</span>
                            </div>
                            <form asp-controller="Favorite" asp-action="Toggle" method="post" class="favorite-toggle-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="favorite-toggle-button @(item.IsFavorite ? "is-favorite" : string.Empty)"
                                        aria-label="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")"
                                        aria-pressed="@item.IsFavorite" title="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")">
                                    <span aria-hidden="true">@(item.IsFavorite ? "♥" : "♡")</span>
                                </button>
                            </form>
                        </div>
                        <div class="product-body">
                            <h3>@item.Name</h3>
                            <p class="product-desc">@item.Description</p>
                            <div class="product-foot">
                                <span class="price">@item.Price.ToString("N0")<small>₫</small></span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="add-btn" aria-label="Thêm @item.Name vào giỏ">
                                        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
                                        Đặt món
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            }

            @if (!Model.Products.Any())
            {
                <p class="empty-menu-message">Thực đơn đang được cập nhật. Mời bạn quay lại sau nhé!</p>
            }
            else
            {
                <p class="empty-menu-message menu-no-results" hidden>
                    Không tìm thấy món phù hợp. Hãy thử từ khóa khác hoặc chọn danh mục khác.
                </p>
            }
        </div>
        <details class="image-credits mt-4">
            <summary>Nguồn ảnh và giấy phép</summary>
            <ul>
                <li><a href="https://commons.wikimedia.org/wiki/File:Chendol2.jpg" target="_blank" rel="noopener noreferrer">Chendol2</a> — Jess Lander, CC BY 2.0.</li>
                <li><a href="https://commons.wikimedia.org/wiki/File:Ch%C3%A8_kh%C3%BAc_b%E1%BA%A1ch_%E1%BB%9F_qu%C3%A1n_Th%E1%BA%A3o_Vy_2020_09_06.jpg" target="_blank" rel="noopener noreferrer">Chè khúc bạch ở quán Thảo Vy</a> — Phương Huy, CC BY-SA 4.0.</li>
                <li><a href="https://commons.wikimedia.org/wiki/File:Ch%C3%A8_Th%C6%B0ng.jpg" target="_blank" rel="noopener noreferrer">Chè Thưng</a> — Zxcvasdfqwer888, CC BY-SA 3.0.</li>
                <li><a href="https://commons.wikimedia.org/wiki/File:Ch%C3%A8_%C4%91%E1%BB%97_xanh.jpg" target="_blank" rel="noopener noreferrer">Chè đỗ xanh</a> — Hoangkid, CC BY-SA 4.0.</li>
                <li><a href="https://commons.wikimedia.org/wiki/File:Ch%C3%A8_B%E1%BA%AFp.jpg" target="_blank" rel="noopener noreferrer">Chè Bắp</a> — Zxcvasdfqwer888, CC BY-SA 3.0.</li>
                <li><a href="https://commons.wikimedia.org/wiki/File:Ch%C3%A8_b%C3%A0_ba.jpg" target="_blank" rel="noopener noreferrer">Chè bà ba</a> — Zxcvasdfqwer888, CC BY-SA 3.0.</li>
                <li><a href="https://commons.wikimedia.org/wiki/File:A_cup,_spoon_and_pot_of_Vietnamese_dessert-_banana,_tapioca_pudding.jpg" target="_blank" rel="noopener noreferrer">Vietnamese banana tapioca pudding</a> — HungryHuy, CC BY 2.0.</li>
            </ul>
            <p class="mb-0">Ảnh dùng để minh họa món chè; một số ảnh thể hiện món chè gần giống thay vì đúng biến thể trong tên món.</p>
        </details>
    </div>
</section>

@if (Model.BestSellers.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Được gọi nhiều nhất</span>
                    <h2>Best sellers tuần này</h2>
                    <p class="section-lead">Những ly chè khách quay lại gọi lần thứ hai, thứ ba — và có khi cả tuần.</p>
                </div>
                <a class="btn btn-ghost" href="#menu">
                    Xem tất cả
                    <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg>
                </a>
            </div>

            <div class="best-grid">
                @foreach (var item in Model.BestSellers)
                {
                    <article class="best-card" data-reveal>
                        <div class="best-image">
                            <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">
                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/menu/che-ba-mau.jpg" : item.ImageUrl)" alt="@item.Name" loading="lazy" />
                            </a>
                            <form asp-controller="Favorite" asp-action="Toggle" method="post" class="favorite-toggle-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="favorite-toggle-button @(item.IsFavorite ? "is-favorite" : string.Empty)"
                                        aria-label="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")"
                                        aria-pressed="@item.IsFavorite" title="@(item.IsFavorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích")">
                                    <span aria-hidden="true">@(item.IsFavorite ? "♥" : "♡")</span>
                                </button>
                            </form>
                        </div>
                        <div class="best-content">
                            <span class="small-badge">
                                <svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>
                                Được yêu thích
                            </span>
                            <h4><a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h4>
                            <div class="best-meta">
                                <span class="price">@item.Price.ToString("N0")<small>₫</small></span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="add-btn" aria-label="Thêm @item.Name vào giỏ">Đặt món</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section id="offers" class="section">
    <div class="container">
        <div class="promo-box" data-reveal>
            <div>
                <span class="eyebrow light">Ưu đãi thành viên mới</span>
                <h3>Ly chè đầu tiên, ngọt hơn với 10% giảm giá</h3>
                <p>
                    Áp dụng cho đơn hàng đầu tiên từ 100.000₫. Nhập mã khi thanh toán để nhận ưu đãi —
                    không giới hạn món, chỉ giới hạn số lượng mỗi ngày.
                </p>
            </div>
            <div class="promo-actions">
                <button type="button" class="coupon" data-copy="SAIGON10" aria-label="Sao chép mã SAIGON10">
                    <svg class="icon" aria-hidden="true"><use href="#i-copy" /></svg>
                    <span>
                        <small>Mã giảm giá</small>
                        <strong>SAIGON10</strong>
                    </span>
                    <span class="copy-hint" data-copy-label>Nhấn để sao chép</span>
                </button>
                <a class="btn btn-primary" href="#menu">
                    Đặt món ngay
                    <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section section-muted">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow">Khách hàng nói gì</span>
                <h2>Ngọt ngào, nhưng là thật</h2>
                <p class="section-lead">Những chia sẻ từ khách quen, người mới và các bạn sinh viên ghé quán mỗi chiều.</p>
            </div>
            <div class="stars" aria-label="Đánh giá trung bình 4.9 trên 5">
                @for (var i = 0; i < 5; i++)
                {
                    <svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>
                }
            </div>
        </div>

        <div class="testimonial-grid">
            @foreach (var review in Model.Testimonials)
            {
                <article class="testimonial-card" data-reveal>
                    <div class="testimonial-top">
                        <div class="avatar">@review.Avatar</div>
                        <div>
                            <h5>@review.Name</h5>
                            <div class="stars" aria-label="@review.Rating trên 5 sao">
                                @for (var i = 0; i < review.Rating; i++)
                                {
                                    <svg class="icon" aria-hidden="true"><use href="#i-star" /></svg>
                                }
                            </div>
                        </div>
                        <span class="quote-mark" aria-hidden="true">
                            <svg class="icon"><use href="#i-chat" /></svg>
                        </span>
                    </div>
                    <p>@review.Content</p>
                </article>
            }
        </div>
        @if (!Model.HasLiveTestimonials)
        {
            <p class="sample-note">* Đây là nội dung giới thiệu mẫu, hiển thị khi chưa có đánh giá thực.</p>
        }
    </div>
</section>

<section id="contact" class="section">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info" data-reveal>
                <span class="eyebrow">Liên hệ</span>
                <h2>Ghé quán, hoặc để chúng tôi mang chè đến</h2>
                <p>Đặt tiệc, hỏi món mới hay chỉ muốn nhắn một lời khen — quán luôn sẵn lòng nghe bạn.</p>
                <ul class="contact-list">
                    <li>
                        <span class="icon-wrap"><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg></span>
                        <div>
                            <strong>Địa chỉ</strong>
                            Thông tin sẽ được cập nhật
                        </div>
                    </li>
                    <li>
                        <span class="icon-wrap"><svg class="icon" aria-hidden="true"><use href="#i-phone" /></svg></span>
                        <div>
                            <strong>Điện thoại</strong>
                            Thông tin sẽ được cập nhật
                        </div>
                    </li>
                    <li>
                        <span class="icon-wrap"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg></span>
                        <div>
                            <strong>Giờ mở cửa</strong>
                            Mỗi ngày · 08:00 – 22:00
                        </div>
                    </li>
                    <li>
                        <span class="icon-wrap"><svg class="icon" aria-hidden="true"><use href="#i-mail" /></svg></span>
                        <div>
                            <strong>Email</strong>
                            xinchao&#64;chesaigon.vn
                        </div>
                    </li>
                </ul>
            </div>

            <form class="contact-form" asp-action="Contact" asp-controller="Home" method="post" data-reveal>
                @Html.AntiForgeryToken()
                <h3>Gửi lời nhắn cho quán</h3>

                @if (TempData["ContactSuccess"] is string successMessage)
                {
                    <div class="alert alert-success" role="status">
                        <span>@successMessage</span>
                    </div>
                }
                @if (TempData["ContactError"] is string errorMessage)
                {
                    <div class="alert alert-danger" role="alert">
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="FullName">Họ tên</label>
                        <input id="FullName" name="FullName" class="form-control" maxlength="100"
                               placeholder="Nhập họ tên" required
                               data-val="true" data-val-required="Vui lòng nhập họ tên." />
                        <span class="text-danger small" data-valmsg-for="FullName" data-valmsg-replace="true"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="Contact">Số điện thoại / Email</label>
                        <input id="Contact" name="Contact" class="form-control" maxlength="200"
                               placeholder="Số điện thoại hoặc email" required
                               data-val="true" data-val-required="Vui lòng nhập thông tin liên hệ." />
                        <span class="text-danger small" data-valmsg-for="Contact" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="Message">Nội dung</label>
                    <textarea id="Message" name="Message" rows="5" class="form-control" minlength="10" maxlength="2000"
                              placeholder="Bạn muốn đặt hàng, hỏi về món ăn hay đặt tiệc?" required
                              data-val="true" data-val-required="Vui lòng nhập nội dung."></textarea>
                    <span class="text-danger small" data-valmsg-for="Message" data-valmsg-replace="true"></span>
                </div>

                <div class="form-footer">
                    <button type="submit" class="btn btn-primary">
                        Gửi liên hệ
                        <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                    </button>
                    <span class="form-help">Chúng tôi phản hồi trong vòng 24 giờ.</span>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
