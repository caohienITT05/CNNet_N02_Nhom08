@{
    ViewData["Title"] = "Chính sách bảo mật";
}

<section class="section">
    <div class="container container-narrow">
        <div class="page-head">
            <span class="eyebrow">Chính sách</span>
            <h1>Bảo mật thông tin khách hàng</h1>
            <p>Chúng tôi chỉ dùng thông tin bạn cung cấp để xử lý đơn hàng và liên hệ khi cần thiết.</p>
        </div>

        <div class="admin-form-wrap" style="max-width:100%">
            <div class="form-group">
                <h3>Thông tin chúng tôi thu thập</h3>
                <p class="cell-muted">Họ tên, số điện thoại và địa chỉ giao hàng khi bạn đặt món hoặc gửi liên hệ.</p>
            </div>
            <div class="form-group">
                <h3>Mục đích sử dụng</h3>
                <p class="cell-muted">Xác nhận đơn, giao hàng và phản hồi tin nhắn của bạn. Chúng tôi không bán hoặc chia sẻ dữ liệu cho bên thứ ba.</p>
            </div>
            <div class="form-group">
                <h3>Lưu trữ</h3>
                <p class="cell-muted">Dữ liệu được lưu trong hệ thống nội bộ của Chè Sài Gòn và chỉ nhân viên có quyền mới truy cập được.</p>
            </div>
        </div>
    </div>
</section>
