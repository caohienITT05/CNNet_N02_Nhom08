@model SaigonChe.Web.ViewModels.AdminReviewsViewModel
@{
    ViewData["Title"] = "Quản lý đánh giá";
}

<section class="section-spacing">
    <div class="container admin-layout">
        <div class="admin-header">
            <div>
                <span class="eyebrow accent">Quản trị</span>
                <h1>Quản Lý Đánh Giá</h1>
            </div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">Dashboard</a>
        </div>

        @if (TempData["AdminReviewMessage"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        @if (TempData["AdminReviewError"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label asp-for="ProductId" class="form-label">Món chè</label>
                <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                    <option value="">Tất cả món</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Rating" class="form-label">Số sao</label>
                <select asp-for="Rating" class="form-select">
                    <option value="">Tất cả mức sao</option>
                    @for (var value = 5; value >= 1; value--)
                    {
                        <option value="@value">@value sao</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="IsHidden" class="form-label">Trạng thái</label>
                <select asp-for="IsHidden" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="false">Đang hiển thị</option>
                    <option value="true">Đang ẩn</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Lọc</button>
            </div>
        </form>

        @if (Model.Reviews.Count == 0)
        {
            <div class="empty-state"><p>Không có đánh giá phù hợp.</p></div>
        }
        else
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="review-card">
                        <div class="review-card-heading">
                            <div>
                                <strong>@review.ProductName</strong>
                                <span>— @review.CustomerName</span>
                            </div>
                            <time datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                        </div>
                        <p class="stars" aria-label="@review.Rating trên 5 sao">
                            @for (var star = 0; star < review.Rating; star++)
                            {
                                <span>★</span>
                            }
                        </p>
                        <p>@review.Comment</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <form asp-action="SetVisibility" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@review.Id" />
                                <input type="hidden" name="isHidden" value="@(!review.IsHidden)" />
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="rating" value="@Model.Rating" />
                                <input type="hidden" name="hiddenFilter" value="@Model.IsHidden" />
                                <button type="submit" class="btn btn-sm @(review.IsHidden ? "btn-success" : "btn-outline-danger")">
                                    @(review.IsHidden ? "Hiện đánh giá" : "Ẩn đánh giá")
                                </button>
                            </form>
                            <span class="badge @(review.IsHidden ? "text-bg-secondary" : "text-bg-success")">
                                @(review.IsHidden ? "Đang ẩn" : "Đang hiển thị")
                            </span>
                        </div>

                        <form asp-action="Reply" method="post" class="admin-reply-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ReviewId" value="@review.Id" />
                            <input type="hidden" name="ProductId" value="@Model.ProductId" />
                            <input type="hidden" name="Rating" value="@Model.Rating" />
                            <input type="hidden" name="IsHidden" value="@Model.IsHidden" />
                            <label for="reply-@review.Id" class="form-label">Phản hồi của quán</label>
                            <textarea id="reply-@review.Id" name="AdminReply" class="form-control" rows="3"
                                      maxlength="1000" required>@review.AdminReply</textarea>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">
                                @(string.IsNullOrWhiteSpace(review.AdminReply) ? "Gửi phản hồi" : "Cập nhật phản hồi")
                            </button>
                        </form>
                        @if (!string.IsNullOrWhiteSpace(review.AdminReply))
                        {
                            <form asp-action="DeleteReply" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@review.Id" />
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="rating" value="@Model.Rating" />
                                <input type="hidden" name="isHidden" value="@Model.IsHidden" />
                                <button type="submit" class="btn btn-link text-danger">Xóa phản hồi</button>
                            </form>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>
