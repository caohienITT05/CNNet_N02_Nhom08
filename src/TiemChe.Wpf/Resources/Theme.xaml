<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:local="clr-namespace:TiemChe.Wpf.Resources">
    <SolidColorBrush x:Key="Cream" Color="#FAF7EF" />
    <SolidColorBrush x:Key="Paper" Color="#FFFDFA" />
    <SolidColorBrush x:Key="Ink" Color="#18392B" />
    <SolidColorBrush x:Key="Muted" Color="#52665C" />
    <SolidColorBrush x:Key="Forest" Color="#154533" />
    <SolidColorBrush x:Key="Leaf" Color="#25724B" />
    <SolidColorBrush x:Key="Mint" Color="#E8F1E8" />
    <SolidColorBrush x:Key="Edge" Color="#E7E5D9" />
    <SolidColorBrush x:Key="Berry" Color="#8A3431" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:DisplayConverter x:Key="Display" />

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Price" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Leaf}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
    <Style x:Key="SecretField" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
    <Style x:Key="ComboField" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
    <Style x:Key="DateField" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignDatePicker}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{StaticResource Leaf}" />
        <Setter Property="BorderBrush" Value="{StaticResource Leaf}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="0,3,8,3" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="9" />
    </Style>
    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="#A4B8A8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="0,3,8,3" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="9" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="8" />
    </Style>
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="1,1,12,18" />
    </Style>
    <Style x:Key="Table" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
    </Style>

    <DataTemplate x:Key="ProductTile">
        <Button Width="190" Height="175" Margin="0,0,12,12" Padding="0"
                AutomationProperties.Name="{Binding Name}"
                Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{StaticResource Paper}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Leaf}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Leaf}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Margin="7,7,7,0" CornerRadius="8" Background="{StaticResource Mint}" ClipToBounds="True">
                    <Grid>
                        <md:PackIcon Kind="BowlMixOutline" Width="42" Height="42" Foreground="{StaticResource Leaf}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding ImagePath, Converter={StaticResource Display}, ConverterParameter=Image}"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="12,8">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock Text="{Binding FromPriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                               Style="{StaticResource Price}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
