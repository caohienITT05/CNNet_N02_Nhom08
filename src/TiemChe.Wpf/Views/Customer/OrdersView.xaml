<UserControl x:Class="TiemChe.Wpf.Views.Customer.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <WrapPanel>
                    <TextBox Style="{StaticResource Field}" Width="220" Margin="0,0,12,5" md:HintAssist.Hint="Mã đơn, người nhận hoặc điện thoại"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Style="{StaticResource ComboField}" Width="165" Margin="0,0,12,5" md:HintAssist.Hint="Trạng thái"
                              ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status}"/>
                    <ComboBox Style="{StaticResource ComboField}" Width="145" Margin="0,0,12,5" md:HintAssist.Hint="Kênh đơn"
                              Visibility="{Binding Operations, Converter={StaticResource BoolVisibility}}"
                              ItemsSource="{Binding Channels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Channel}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Lọc đơn" Command="{Binding SearchOrdersCommand}" IsDefault="True"/>
                    <Button Style="{StaticResource SoftButton}" Content="Xem chi tiết" Command="{Binding OpenCommand}"/>
                </WrapPanel>
                <WrapPanel Visibility="{Binding Operations, Converter={StaticResource BoolVisibility}}">
                    <Button Style="{StaticResource SoftButton}" Content="Hôm nay" Command="{Binding QuickRangeCommand}" CommandParameter="today"/>
                    <Button Style="{StaticResource SoftButton}" Content="Hôm qua" Command="{Binding QuickRangeCommand}" CommandParameter="yesterday"/>
                    <Button Style="{StaticResource SoftButton}" Content="7 ngày" Command="{Binding QuickRangeCommand}" CommandParameter="week"/>
                    <Button Style="{StaticResource SoftButton}" Content="Tất cả" Command="{Binding QuickRangeCommand}" CommandParameter="all"/>
                    <DatePicker Style="{StaticResource DateField}" Width="125" Margin="4,0,8,5" md:HintAssist.Hint="Từ ngày" SelectedDate="{Binding From}"/>
                    <DatePicker Style="{StaticResource DateField}" Width="125" Margin="0,0,12,5" md:HintAssist.Hint="Đến ngày" SelectedDate="{Binding To}"/>
                    <ComboBox Style="{StaticResource ComboField}" Width="175" Margin="0,0,12,5" md:HintAssist.Hint="Phương thức thanh toán"
                              ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding PaymentMethod}"/>
                    <ComboBox Style="{StaticResource ComboField}" Width="160" Margin="0,0,12,5" md:HintAssist.Hint="Trạng thái thanh toán"
                              ItemsSource="{Binding PaymentStatuses}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding PaymentStatus}"/>
                    <CheckBox Content="Đơn cũ nhất trước" IsChecked="{Binding OldestFirst}" VerticalAlignment="Center" Margin="0,0,14,5"/>
                    <CheckBox Content="Âm báo đơn mới" IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center" Margin="0,0,14,5"/>
                </WrapPanel>
                <DataGrid Style="{StaticResource Table}" Height="390" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderNumber}" Width="155"/>
                        <DataGridTextColumn Header="Người nhận" Binding="{Binding Recipient}" Width="*"/>
                        <DataGridTextColumn Header="Kênh" Binding="{Binding Channel, Converter={StaticResource Display}}" Width="90"/>
                        <DataGridTextColumn Header="Ngày đặt" Binding="{Binding PlacedAtUtc, Converter={StaticResource Display}, ConverterParameter=Date}" Width="133"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource Display}}" Width="115"/>
                        <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus, Converter={StaticResource Display}}" Width="130"/>
                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Trang trước" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Trang sau" Command="{Binding NextCommand}"/>
                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
