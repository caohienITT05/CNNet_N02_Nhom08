<UserControl x:Class="TiemChe.Wpf.Views.Customer.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Button Style="{StaticResource SoftButton}" Content="‹ Thực đơn" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <StackPanel Visibility="{Binding Product, Converter={StaticResource Display}, ConverterParameter=Visible}">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Mint}" CornerRadius="14" Height="258" VerticalAlignment="Top" ClipToBounds="True">
                        <Grid>
                            <md:PackIcon Kind="BowlMixOutline" Foreground="{StaticResource Leaf}" Width="86" Height="86"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Product.ImagePath, Converter={StaticResource Display}, ConverterParameter=Image}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Product.Name}" Style="{StaticResource Title}"/>
                            <TextBlock Text="{Binding Product.Description}" Style="{StaticResource MutedText}" Margin="0,8,0,10"/>
                            <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Chọn size" ItemsSource="{Binding Product.Sizes}" SelectedItem="{Binding SelectedSize}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding PriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Topping" FontWeight="SemiBold" Margin="0,3,0,3"/>
                            <ItemsControl ItemsSource="{Binding Toppings}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected}" Margin="0,0,15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Topping.Name}" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Topping.PriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Số lượng" Width="90" Margin="0,0,14,0"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Số lượng món"/>
                                <TextBlock Text="{Binding PriceLabel}" Style="{StaticResource Price}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Thêm vào giỏ" Command="{Binding AddToCartCommand}"/>
                                <Button Style="{StaticResource SoftButton}" Content="{Binding FavoriteLabel}" Command="{Binding FavoriteCommand}"/>
                                <Button Style="{StaticResource SoftButton}" Content="Mở giỏ hàng" Command="{Binding OpenCartCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Đánh giá của khách" Style="{StaticResource Heading}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Product.AverageRating, StringFormat={}{0:0.0} / 5 sao, TargetNullValue=Chưa có điểm}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Product.ReviewCount, StringFormat={}{0} đánh giá}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <TextBlock Text="Bạn có thể gửi đánh giá từ chi tiết đơn hàng đã hoàn thành." Style="{StaticResource MutedText}"/>
                        <ItemsControl ItemsSource="{Binding Product.Reviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,9" Margin="0,6,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Rating, StringFormat={}{0}/5 sao}" Foreground="{StaticResource Leaf}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
