<UserControl x:Class="TiemChe.Wpf.Views.Customer.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Món trong giỏ" Style="{StaticResource Heading}"/>
                    <DataGrid Style="{StaticResource Table}" Height="290" ItemsSource="{Binding Cart.Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Món" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeName}" Width="*"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="85"/>
                            <DataGridTextColumn Header="Đang bán" Binding="{Binding IsAvailable, Converter={StaticResource Display}}" Width="90"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding Selected, Converter={StaticResource Display}, ConverterParameter=Visible}">
                        <ItemsControl ItemsSource="{Binding Selected.Toppings}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <TextBlock Text="{Binding Name}" Margin="0,0,5,0" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding PriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <TextBox Width="100" Style="{StaticResource Field}" md:HintAssist.Hint="Số lượng" Margin="0,0,12,0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource SoftButton}" Content="Cập nhật số lượng" Command="{Binding UpdateCommand}"/>
                            <Button Style="{StaticResource SoftButton}" Content="Xóa món đã chọn" Command="{Binding RemoveCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Style="{StaticResource SoftButton}" Content="Chọn thêm món" Command="{Binding BrowseCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Thanh toán" Command="{Binding CheckoutCommand}"/>
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tạm tính" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Cart.SubtotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Style="{StaticResource Price}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
