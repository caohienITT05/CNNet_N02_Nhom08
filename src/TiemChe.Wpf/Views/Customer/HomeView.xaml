<UserControl x:Class="TiemChe.Wpf.Views.Customer.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Background="{StaticResource Forest}" CornerRadius="16" Padding="24,19" Margin="0,0,0,16" ClipToBounds="True">
                <Grid MinHeight="138">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="204"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MÓN NGỌT MỖI NGÀY" Foreground="#C0D9C4" FontSize="10.5" FontWeight="Bold"/>
                        <TextBlock Text="Hôm nay ăn chè gì?" FontSize="35" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="Chè thanh mát, trà sữa thơm và topping theo ý bạn." Foreground="#E1EDE2" TextWrapping="Wrap"/>
                        <Button Content="Xem thực đơn" Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="180" Height="130">
                        <Ellipse Width="110" Height="110" Fill="#285740" HorizontalAlignment="Center"/>
                        <Ellipse Width="15" Height="15" Fill="#C1D4A2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,14,0,0"/>
                        <Ellipse Width="9" Height="9" Fill="#A0B783" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"/>
                        <md:PackIcon Kind="BowlMixOutline" Width="88" Height="88" Foreground="#DDECCE"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Banners}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SoftButton}" Padding="5" Height="98" Width="245"
                                Command="{Binding DataContext.OpenBannerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Grid ClipToBounds="True" Width="225" Height="84">
                                <Image Source="{Binding ImagePath, Converter={StaticResource Display}, ConverterParameter=Image}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Background="#CC154533" Padding="6">
                                    <TextBlock Text="{Binding Title}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Danh mục" Style="{StaticResource Heading}"/>
            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,15">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Style="{StaticResource SoftButton}" Background="{StaticResource Paper}"
                                Command="{Binding DataContext.BrowseCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Món bán chạy" Style="{StaticResource Heading}"/>
            <ItemsControl ItemsSource="{Binding Popular}" ItemTemplate="{StaticResource ProductTile}" Margin="0,0,0,9">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Món mới" Style="{StaticResource Heading}"/>
            <ItemsControl ItemsSource="{Binding Newest}" ItemTemplate="{StaticResource ProductTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
