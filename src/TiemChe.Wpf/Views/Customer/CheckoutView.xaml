<UserControl x:Class="TiemChe.Wpf.Views.Customer.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Button Style="{StaticResource SoftButton}" Content="‹ Giỏ hàng" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Giao hàng và thanh toán" Style="{StaticResource Heading}"/>
                        <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Địa chỉ nhận hàng" ItemsSource="{Binding Addresses}"
                                  SelectedItem="{Binding SelectedAddress}" DisplayMemberPath="AddressLine"/>
                        <TextBlock Text="{Binding SelectedAddress.RecipientName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedAddress.Phone}" Style="{StaticResource MutedText}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Quản lý địa chỉ" Command="{Binding ManageAddressesCommand}" HorizontalAlignment="Left" Margin="0,8,0,9"/>
                        <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Phương thức thanh toán" ItemsSource="{Binding Methods}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Method}"/>
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Mã giảm giá (tùy chọn)" Text="{Binding Coupon, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Tính tổng tiền" Command="{Binding CalculateCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Tóm tắt đơn" Style="{StaticResource Heading}"/>
                        <ItemsControl ItemsSource="{Binding Cart.Items}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Margin="8,0,0,0"/>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ProductName, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Quantity, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Cart.SubtotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/><TextBlock Text="Tiền món"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding ShippingFee, Converter={StaticResource Display}, ConverterParameter=Money}"/><TextBlock Text="Phí giao"/></DockPanel>
                        <StackPanel Visibility="{Binding HasQuote, Converter={StaticResource BoolVisibility}}">
                            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Quote.DiscountVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/><TextBlock Text="Giảm giá"/></DockPanel>
                            <Separator Margin="0,9"/>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Price}" Text="{Binding Quote.TotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/><TextBlock Text="Tổng thanh toán" FontWeight="Bold"/></DockPanel>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Xác nhận đặt đơn" Command="{Binding PlaceCommand}" IsEnabled="{Binding HasQuote}" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
