<UserControl x:Class="TiemChe.Wpf.Views.Customer.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14" Padding="15,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Tên món, danh mục hoặc mô tả"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm món"/>
                        <ComboBox Grid.Column="2" Style="{StaticResource ComboField}" md:HintAssist.Hint="Danh mục" ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CategoryId}" />
                        <ComboBox Grid.Column="4" Style="{StaticResource ComboField}" md:HintAssist.Hint="Sắp xếp" ItemsSource="{Binding Sorts}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sort}" />
                    </Grid>
                    <WrapPanel>
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Giá thấp nhất (đồng)" Width="155" Margin="0,0,12,0"
                                 Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Giá cao nhất (đồng)" Width="155" Margin="0,0,12,0"
                                 Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Áp dụng bộ lọc" IsDefault="True" Command="{Binding FilterCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SoftButton}" Content="Trang trước" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Trang sau" Command="{Binding NextCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ProductTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
