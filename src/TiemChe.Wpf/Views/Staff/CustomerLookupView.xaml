<UserControl x:Class="TiemChe.Wpf.Views.Staff.CustomerLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Khách hàng" Style="{StaticResource Heading}"/>
                    <WrapPanel>
                        <TextBox Style="{StaticResource Field}" Width="230" Margin="0,0,10,5"
                                 md:HintAssist.Hint="Tên, số điện thoại hoặc email"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Tìm"
                                Command="{Binding SearchCustomersCommand}" IsDefault="True"/>
                    </WrapPanel>
                    <DataGrid Style="{StaticResource Table}" Height="420" ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="125"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCustomer.FullName, StringFormat=Lịch sử đơn · {0}}"
                               Style="{StaticResource Heading}"/>
                    <DataGrid Style="{StaticResource Table}" Height="420" ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderNumber}" Width="150"/>
                            <DataGridTextColumn Header="Kênh" Binding="{Binding Channel, Converter={StaticResource Display}}" Width="90"/>
                            <DataGridTextColumn Header="Ngày đặt" Binding="{Binding PlacedAtUtc, Converter={StaticResource Display}, ConverterParameter=Date}" Width="130"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource Display}}" Width="110"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource SoftButton}" Content="Trang trước" Command="{Binding PreviousCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Trang sau" Command="{Binding NextCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Mở đơn"
                                Command="{Binding OpenOrderCommand}"/>
                        <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
