<UserControl x:Class="TiemChe.Wpf.Views.Staff.StaffOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Tải lại"
                            Command="{Binding ReloadCommand}"/>
                    <StackPanel>
                        <TextBlock Text="Đơn tại quầy" Style="{StaticResource Heading}" Margin="0"/>
                        <TextBlock Text="Chọn món cho khách, kiểm tra tổng tiền và tạo đơn ngay tại cửa hàng."
                                   Style="{StaticResource MutedText}"/>
                        <TextBlock Text="Bạn chưa mở ca; vẫn có thể tạo đơn tại quầy."
                                   Style="{StaticResource MutedText}"
                                   Visibility="{Binding ShowShiftWarning, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Thực đơn" Style="{StaticResource Heading}"/>
                            <WrapPanel>
                                <TextBox Style="{StaticResource Field}" Width="235" Margin="0,0,10,5"
                                         md:HintAssist.Hint="Tìm món hoặc danh mục (không dấu)"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Style="{StaticResource ComboField}" Width="165" Margin="0,0,10,5"
                                          md:HintAssist.Hint="Danh mục"
                                          ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding CategoryId}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Tìm"
                                        Command="{Binding ApplyFilterCommand}" IsDefault="True"/>
                            </WrapPanel>
                            <ScrollViewer Height="270" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SoftButton}" Margin="0,0,0,7"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.ChooseProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                               Text="{Binding FromPriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                                               Style="{StaticResource Price}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Style="{StaticResource MutedText}">
                                                            <Run Text="{Binding CategoryName, Mode=OneWay}"/><Run Text=" · từ "/><Run Text="{Binding FromPriceVnd, Converter={StaticResource Display}, ConverterParameter=Money, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0"
                            Visibility="{Binding Product, Converter={StaticResource Display}, ConverterParameter=Visible}">
                        <StackPanel>
                            <TextBlock Text="{Binding Product.Name}" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding Product.Description}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Size"
                                      ItemsSource="{Binding Product.Sizes}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedSize}"/>
                            <TextBlock Text="Topping" FontWeight="SemiBold" Margin="0,2,0,4"/>
                            <ItemsControl ItemsSource="{Binding Toppings}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected}" Margin="0,0,18,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Topping.Name}"/>
                                                <TextBlock Text="{Binding Topping.PriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                                           Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,0">
                                <TextBox Style="{StaticResource Field}" Width="90" Margin="0,0,12,5"
                                         md:HintAssist.Hint="Số lượng"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding ConfiguredPriceLabel}" Style="{StaticResource Price}"
                                           VerticalAlignment="Center" Margin="0,0,14,8"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Thêm vào đơn"
                                        Command="{Binding AddLineCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Đơn hiện tại" Style="{StaticResource Heading}"/>
                            <DataGrid Style="{StaticResource Table}" Height="250" RowHeight="58"
                                      ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Món" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource MutedText}">
                                                        <Run Text="{Binding SizeName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ToppingLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Số lượng" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="−" Width="26" Height="26" Padding="0"
                                                            Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Quantity}" Margin="8,0" VerticalAlignment="Center"/>
                                                    <Button Content="+" Width="26" Height="26" Padding="0"
                                                            Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Thành tiền" Width="105"
                                                        Binding="{Binding LineTotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/>
                                    <DataGridTemplateColumn Header="" Width="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="×" Width="28" Height="28" Padding="0"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                           Style="{StaticResource Price}" FontSize="22"/>
                                <TextBlock Text="Tổng tiền" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.SubtotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/>
                                <TextBlock Text="Tạm tính" Style="{StaticResource MutedText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Quote.DiscountVnd, Converter={StaticResource Display}, ConverterParameter=Money}"/>
                                <TextBlock Text="Giảm giá" Style="{StaticResource MutedText}"/>
                            </DockPanel>
                            <TextBlock Text="Đang tính lại tổng tiền…" Style="{StaticResource MutedText}"
                                       Visibility="{Binding IsQuoting, Converter={StaticResource BoolVisibility}}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0"
                            Visibility="{Binding ShowForm, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Thông tin khách" Style="{StaticResource Heading}"/>
                            <WrapPanel>
                                <TextBox Style="{StaticResource Field}" Width="230" Margin="0,0,10,5"
                                         md:HintAssist.Hint="Tìm khách theo tên, số điện thoại hoặc email"
                                         Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource SoftButton}" Content="Tìm khách"
                                        Command="{Binding SearchCustomersCommand}"/>
                            </WrapPanel>
                            <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Chọn khách có tài khoản (để trống nếu khách vãng lai)"
                                      ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource MutedText}">
                                                <Run Text="{Binding Phone, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Email, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Tên khách (mặc định Khách lẻ)"
                                     Text="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Số điện thoại (tùy chọn)"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource Field}" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                                     md:HintAssist.Hint="Ghi chú cho bếp (tùy chọn)"
                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Phương thức thanh toán"
                                      ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding PaymentMethod}"/>
                            <TextBlock Text="{Binding PaymentHint}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Cách xử lý đơn"
                                      ItemsSource="{Binding CompletionModes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding CompleteNow}"/>
                            <CheckBox Content="Đã nhận chuyển khoản" IsChecked="{Binding PaymentReceived}"
                                      Visibility="{Binding ShowPaymentReceived, Converter={StaticResource BoolVisibility}}"/>
                            <WrapPanel>
                                <TextBox Style="{StaticResource Field}" Width="200" Margin="0,0,10,5"
                                         md:HintAssist.Hint="Mã giảm giá"
                                         Text="{Binding CouponCode, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource SoftButton}" Content="Áp dụng mã"
                                        Command="{Binding ApplyCouponCommand}"/>
                            </WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="Tạo đơn tại quầy"
                                    Command="{Binding CreateOrderCommand}" IsEnabled="{Binding CanCreateOrder}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0"
                            Visibility="{Binding CreatedOrder, Converter={StaticResource Display}, ConverterParameter=Visible}">
                        <StackPanel>
                            <TextBlock Text="Đã tạo đơn tại quầy" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding CreatedOrder.OrderNumber}" Style="{StaticResource Price}" FontSize="24"/>
                            <TextBlock Text="{Binding CreatedOrder.PlacedAtUtc, Converter={StaticResource Display}, ConverterParameter=Date}"
                                       Style="{StaticResource MutedText}"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding CreatedOrder.Amounts.TotalVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                           Style="{StaticResource Price}"/>
                                <TextBlock Text="{Binding CreatedOrder.Payment.Method, Converter={StaticResource Display}}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="{StaticResource Mint}" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                                    Visibility="{Binding HasQr, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Quét mã VietQR để thanh toán" FontWeight="SemiBold"/>
                                    <Image Width="190" Height="190" Stretch="Uniform" Margin="0,8"
                                           Source="{Binding CreatedOrder.Payment.BankTransfer.QrImageUrl, Converter={StaticResource Display}, ConverterParameter=Qr}"/>
                                    <TextBlock Text="{Binding CreatedOrder.Payment.BankTransfer.BankName}" Style="{StaticResource MutedText}"/>
                                    <TextBlock><Run Text="Số tài khoản: "/><Run Text="{Binding CreatedOrder.Payment.BankTransfer.AccountNumber, Mode=OneWay}"/></TextBlock>
                                    <TextBlock><Run Text="Nội dung: "/><Run Text="{Binding CreatedOrder.Payment.BankTransfer.Reference, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SoftButton}" Content="In hóa đơn"
                                        Command="{Binding PrintInvoiceCommand}"/>
                                <Button Style="{StaticResource SoftButton}" Content="In phiếu bếp"
                                        Command="{Binding PrintKitchenCommand}"/>
                                <Button Style="{StaticResource SoftButton}" Content="In tem cốc"
                                        Command="{Binding PrintCupsCommand}"/>
                                <Button Style="{StaticResource SoftButton}" Content="Mở chi tiết đơn"
                                        Command="{Binding OpenCreatedOrderCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Đơn mới"
                                        Command="{Binding NewOrderCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
