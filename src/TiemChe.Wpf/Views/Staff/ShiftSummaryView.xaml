<UserControl x:Class="TiemChe.Wpf.Views.Staff.ShiftSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14" Padding="14,10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Style="{StaticResource SoftButton}" Content="Lịch sử ca"
                                Command="{Binding OpenHistoryCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Tải lại"
                                Command="{Binding ReloadCommand}"/>
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="Tổng quan ca làm việc" Style="{StaticResource Heading}" Margin="0"/>
                        <TextBlock Text="{Binding Summary.Date, StringFormat='Ngày {0:dd/MM/yyyy}'}"
                                   Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <UniformGrid Columns="5" Margin="0,0,0,14">
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Chờ xác nhận" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.PendingCount}" Style="{StaticResource Price}" FontSize="24"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Chờ xác nhận chưa thanh toán" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.PendingUnpaidCount}" Style="{StaticResource Price}" FontSize="24"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Tiền mặt đã thu" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.CashCollectedVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                   Style="{StaticResource Price}" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Chuyển khoản đã xác nhận" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.ConfirmedTransferVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                   Style="{StaticResource Price}" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Đơn tôi xử lý hôm nay" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.MyHandledOrders}" Style="{StaticResource Price}" FontSize="24"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Ca làm việc" Style="{StaticResource Heading}"/>
                    <StackPanel Visibility="{Binding HasOpenShift, Converter={StaticResource BoolVisibility}}">
                        <WrapPanel>
                            <TextBlock Text="{Binding CurrentShift.OpenedAtUtc, Converter={StaticResource Display}, ConverterParameter=Date}"
                                       Style="{StaticResource MutedText}" Margin="0,0,18,8"/>
                            <TextBlock Text="{Binding CurrentShift.OpeningCashVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                       Style="{StaticResource MutedText}" Margin="0,0,18,8"/>
                            <TextBlock Text="{Binding CurrentShift.ExpectedCashVnd, Converter={StaticResource Display}, ConverterParameter=Money}"
                                       Style="{StaticResource Price}" Margin="0,0,18,8"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBox Style="{StaticResource Field}" Width="170" Margin="0,0,10,5"
                                     md:HintAssist.Hint="Tiền kiểm đếm (đồng)"
                                     Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource Field}" Width="280" Margin="0,0,10,5"
                                     md:HintAssist.Hint="Ghi chú nếu chênh lệch"
                                     Text="{Binding ClosingNote, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Đóng ca"
                                    Command="{Binding CloseShiftCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowOpenShiftForm, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="Bạn chưa mở ca. Việc mở ca không bắt buộc để tạo đơn tại quầy."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <TextBox Style="{StaticResource Field}" Width="190" Margin="0,0,10,5"
                                     md:HintAssist.Hint="Tiền đầu ca (đồng)"
                                     Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Mở ca"
                                    Command="{Binding OpenShiftCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Button Style="{StaticResource SoftButton}" Content="In biên bản chốt ca"
                            HorizontalAlignment="Left" Command="{Binding PrintShiftCommand}"
                            Visibility="{Binding HasClosedShift, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Đơn theo trạng thái hôm nay" Style="{StaticResource Heading}"/>
                    <ItemsControl ItemsSource="{Binding Summary.Statuses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SoftButton}" Margin="0,0,10,10" Padding="16,10"
                                        Command="{Binding DataContext.OpenStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Status}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource Display}}"
                                                   Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Price}" FontSize="22"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
