<UserControl x:Class="TiemChe.Wpf.Views.Staff.AvailabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14" Padding="14,10">
                <WrapPanel>
                    <TextBox Style="{StaticResource Field}" Width="300" Margin="0,0,10,5"
                             md:HintAssist.Hint="Tìm món, size hoặc topping (không dấu)"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Tìm" Command="{Binding ApplySearchCommand}"
                            IsDefault="True"/>
                </WrapPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,10">
                                                <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                              IsChecked="{Binding IsActive}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Lịch sử thay đổi gần đây" Style="{StaticResource Heading}"/>
                                        <DataGrid Style="{StaticResource Table}" Height="300" ItemsSource="{Binding Logs}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Loại" Binding="{Binding EntityType, Converter={StaticResource Display}}" Width="90"/>
                                                <DataGridTextColumn Header="Tên" Binding="{Binding EntityName}" Width="*"/>
                                                <DataGridTextColumn Header="Trước" Binding="{Binding OldValue, Converter={StaticResource Display}}" Width="75"/>
                                                <DataGridTextColumn Header="Sau" Binding="{Binding NewValue, Converter={StaticResource Display}}" Width="75"/>
                                                <DataGridTextColumn Header="Người đổi" Binding="{Binding ChangedByName}" Width="150"/>
                                                <DataGridTextColumn Header="Thời gian" Binding="{Binding ChangedAtUtc, Converter={StaticResource Display}, ConverterParameter=Date}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
