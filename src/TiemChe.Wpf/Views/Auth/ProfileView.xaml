<UserControl x:Class="TiemChe.Wpf.Views.Auth.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Thông tin cá nhân" Style="{StaticResource Heading}"/>
                    <TextBlock Text="{Binding Role}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Email đăng nhập" Text="{Binding Email, Mode=OneWay}" IsReadOnly="True"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Họ và tên" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Số điện thoại" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Lưu hồ sơ" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Đổi mật khẩu" Style="{StaticResource Heading}"/>
                    <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Mật khẩu hiện tại" r:PasswordBinding.Value="{Binding CurrentPassword}"/>
                    <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Mật khẩu mới" r:PasswordBinding.Value="{Binding NewPassword}"/>
                    <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Nhập lại mật khẩu mới" r:PasswordBinding.Value="{Binding ConfirmPassword}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Đổi mật khẩu" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
