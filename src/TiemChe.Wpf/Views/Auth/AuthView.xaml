<UserControl x:Class="TiemChe.Wpf.Views.Auth.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid MaxWidth="770" VerticalAlignment="Top" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Forest}" CornerRadius="16,0,0,16" Padding="26,35">
                <StackPanel VerticalAlignment="Center">
                    <md:PackIcon Kind="BowlMixOutline" Width="58" Height="58" Foreground="#E1EBDC" Margin="0,0,0,20"/>
                    <TextBlock Text="Một phần chè, thêm một chút vui." Foreground="White" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Đăng nhập để lưu món yêu thích, đặt hàng và theo dõi từng đơn." Foreground="#DFEDE1"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" CornerRadius="0,16,16,0" Padding="22,20" MinHeight="400">
                <TabControl SelectedIndex="{Binding TabIndex}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabItem Header="Đăng nhập">
                        <StackPanel Margin="8,18,8,8">
                            <TextBlock Text="Chào mừng trở lại" Style="{StaticResource Heading}" />
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Email đăng nhập"/>
                            <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Mật khẩu"
                                         r:PasswordBinding.Value="{Binding Password, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mật khẩu đăng nhập"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Đăng nhập" Command="{Binding LoginCommand}" IsDefault="True" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Đăng ký">
                        <StackPanel Margin="8,18,8,8">
                            <TextBlock Text="Tạo tài khoản khách hàng" Style="{StaticResource Heading}"/>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Họ và tên" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Số điện thoại (tùy chọn)" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Mật khẩu (ít nhất 10 ký tự)"
                                         r:PasswordBinding.Value="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Tạo tài khoản" Command="{Binding RegisterCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Quên mật khẩu">
                        <StackPanel Margin="8,18,8,8">
                            <TextBlock Text="Khôi phục tài khoản" Style="{StaticResource Heading}"/>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource SoftButton}" Content="Gửi mã qua email" Command="{Binding SendCodeCommand}" HorizontalAlignment="Left"/>
                            <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Mã trong email" Text="{Binding ResetCode, UpdateSourceTrigger=PropertyChanged}"/>
                            <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Mật khẩu mới"
                                         r:PasswordBinding.Value="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Đặt lại mật khẩu" Command="{Binding ResetCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
