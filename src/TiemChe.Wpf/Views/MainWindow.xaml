<Window x:Class="TiemChe.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tiệm Chè" Width="1250" Height="820" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource Cream}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
            <DockPanel Margin="13,14">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="5,8,0,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Height="38" Width="38" HorizontalAlignment="Left" Background="{StaticResource Forest}" CornerRadius="11">
                            <md:PackIcon Kind="BowlMixOutline" Width="24" Height="24" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tiệm Chè" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Chè • Trà sữa • Topping" FontSize="10.5" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="ĐIỀU HƯỚNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="11,0,0,8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Border Style="{StaticResource Panel}" Padding="10" Background="{StaticResource Cream}">
                        <StackPanel>
                            <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AccountRole}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3"/>
                            <Button Style="{StaticResource NavButton}" Content="Đăng nhập" Command="{Binding GoCommand}"
                                    CommandParameter="login" Visibility="{Binding IsGuest, Converter={StaticResource BoolVisibility}}" />
                            <Button Style="{StaticResource NavButton}" Content="Đăng xuất" Command="{Binding LogoutCommand}"
                                    Visibility="{Binding SignedIn, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="{Binding Icon}" Width="19" Height="19" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24,15,12,0" DataContext="{Binding Navigation.Current}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,12,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Tải lại" Command="{Binding ReloadCommand}"
                        AutomationProperties.Name="Tải lại màn hình"/>
                <StackPanel>
                    <TextBlock Text="TIỆM CHÈ" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Leaf}" Margin="0,1,0,1"/>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" FontSize="25"/>
                </StackPanel>
            </DockPanel>
            <ProgressBar Grid.Row="1" Height="3" Margin="0,0,12,8" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
            <Border Grid.Row="2" Margin="0,0,12,10" Padding="12,8" CornerRadius="8"
                    Visibility="{Binding Notice, Converter={StaticResource Display}, ConverterParameter=Visible}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Mint}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="#F9E9E5"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/>
            </Border>
            <ContentControl Grid.Row="3" Content="{Binding}" IsEnabled="{Binding IsBusy, Converter={StaticResource Display}, ConverterParameter=Inverse}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
