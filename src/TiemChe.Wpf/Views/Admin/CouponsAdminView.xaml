<UserControl x:Class="TiemChe.Wpf.Views.Admin.CouponsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Danh sách" Style="{StaticResource Heading}"/>
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                             MinHeight="100" MaxHeight="490"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Điều kiện áp dụng" Style="{StaticResource Heading}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Mã giảm giá" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Kiểu giảm giá" ItemsSource="{Binding Kinds}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="{Binding ValueHint}" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Giá trị đơn tối thiểu (đồng)" Text="{Binding MinSubtotal, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Giảm tối đa (đồng, tùy chọn)" Text="{Binding MaxDiscount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Giới hạn lượt dùng (tùy chọn)" Text="{Binding UsageLimit, UpdateSourceTrigger=PropertyChanged}" />
                    <DatePicker Style="{StaticResource DateField}" md:HintAssist.Hint="Ngày bắt đầu" SelectedDate="{Binding StartsAt}" />
                    <DatePicker Style="{StaticResource DateField}" md:HintAssist.Hint="Ngày cuối (tùy chọn)" SelectedDate="{Binding EndsAt}" />
                    <CheckBox Content="Cho phép áp dụng" IsChecked="{Binding IsActive}" Margin="0,5,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Lưu" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Tạo mục mới" Command="{Binding ClearCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Ngừng áp dụng" Command="{Binding RemoveCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
