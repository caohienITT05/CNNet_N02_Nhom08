<UserControl x:Class="TiemChe.Wpf.Views.Admin.CategoriesAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Danh sách" Style="{StaticResource Heading}"/>
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                             MinHeight="100" MaxHeight="490"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Thông tin danh mục" Style="{StaticResource Heading}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Tên danh mục" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Thứ tự hiển thị" Text="{Binding DisplayOrder, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Đang hoạt động" IsChecked="{Binding IsActive}" Margin="0,5,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Lưu" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Tạo mục mới" Command="{Binding ClearCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Ngừng hiển thị" Command="{Binding RemoveCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
