<UserControl x:Class="TiemChe.Wpf.Views.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14" Padding="14,10">
                <WrapPanel>
                    <DatePicker Style="{StaticResource DateField}" md:HintAssist.Hint="Từ ngày" Width="125" Margin="0,0,10,5" SelectedDate="{Binding From}"/>
                    <DatePicker Style="{StaticResource DateField}" md:HintAssist.Hint="Đến ngày" Width="125" Margin="0,0,12,5" SelectedDate="{Binding To}"/>
                    <CheckBox Content="Theo tháng" IsChecked="{Binding ByMonth}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Xem báo cáo" Command="{Binding ReloadCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Xuất Excel" Command="{Binding ExportCommand}"/>
                </WrapPanel>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Dashboard.RevenueVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Style="{StaticResource Price}" FontSize="22"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Số đơn đã đặt" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Dashboard.TotalOrders}" Style="{StaticResource Price}" FontSize="22"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Đơn đã thu tiền và hoàn thành" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Dashboard.CompletedOrders}" Style="{StaticResource Price}" FontSize="22"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Doanh thu theo kỳ" Style="{StaticResource Heading}"/>
                    <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="275"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Món bán chạy" Style="{StaticResource Heading}"/>
                    <DataGrid Style="{StaticResource Table}" Height="260" ItemsSource="{Binding Dashboard.BestSellers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Số phần" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Tiền món" Binding="{Binding ItemRevenueVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
