<UserControl x:Class="TiemChe.Wpf.Views.Admin.ReviewsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <WrapPanel>
                    <ComboBox Style="{StaticResource ComboField}" Width="170" Margin="0,0,12,5" ItemsSource="{Binding Filters}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Visible}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Lọc đánh giá" Command="{Binding SearchCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Ẩn hoặc hiện" Command="{Binding ToggleCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Xóa đánh giá" Command="{Binding DeleteCommand}"/>
                </WrapPanel>
                <DataGrid Style="{StaticResource Table}" Height="310" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Khách hàng" Binding="{Binding Author}" Width="*"/>
                        <DataGridTextColumn Header="Mã món" Binding="{Binding ProductId}" Width="75"/>
                        <DataGridTextColumn Header="Sao" Binding="{Binding Rating}" Width="57"/>
                        <DataGridTextColumn Header="Nhận xét" Binding="{Binding Comment}" Width="2*"/>
                        <DataGridTextColumn Header="Đang hiện" Binding="{Binding IsVisible, Converter={StaticResource Display}}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Trang trước" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Trang sau" Command="{Binding NextCommand}"/>
                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Text="{Binding Selected.Comment}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
