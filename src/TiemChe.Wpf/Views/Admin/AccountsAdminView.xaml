<UserControl x:Class="TiemChe.Wpf.Views.Admin.AccountsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <WrapPanel>
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Họ tên hoặc email" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,5"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Tìm tài khoản" Command="{Binding SearchCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Khóa hoặc mở khóa" Command="{Binding ToggleCommand}"/>
                    </WrapPanel>
                    <DataGrid Style="{StaticResource Table}" Height="310" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*"/>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="115"/>
                            <DataGridTextColumn Header="Đang hoạt động" Binding="{Binding IsActive, Converter={StaticResource Display}}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Trang trước" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Trang sau" Command="{Binding NextCommand}"/>
                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Visibility="{Binding Staff, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="Cấp tài khoản nhân viên" Style="{StaticResource Heading}"/>
                    <UniformGrid Columns="2">
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Họ và tên" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Điện thoại (tùy chọn)" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8"/>
                        <PasswordBox Style="{StaticResource SecretField}" md:HintAssist.Hint="Mật khẩu (ít nhất 10 ký tự)" r:PasswordBinding.Value="{Binding Password}"/>
                    </UniformGrid>
                    <Button Style="{StaticResource PrimaryButton}" Content="Tạo tài khoản nhân viên" Command="{Binding CreateStaffCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
