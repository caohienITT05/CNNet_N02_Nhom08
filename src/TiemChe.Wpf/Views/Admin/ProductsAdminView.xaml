<UserControl x:Class="TiemChe.Wpf.Views.Admin.ProductsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:TiemChe.Wpf.Resources"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Danh sách món" Style="{StaticResource Heading}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Tìm tên món" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Tìm" Command="{Binding SearchProductsCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Chỉnh sửa" Command="{Binding EditSelectedCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Thêm món" Command="{Binding NewCommand}"/>
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" MinHeight="110" MaxHeight="440">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Id, StringFormat={}#{0}}" Foreground="{StaticResource Leaf}" FontSize="11"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FromPriceVnd, Converter={StaticResource Display}, ConverterParameter=Money}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Trang trước" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Trang sau" Command="{Binding NextCommand}"/>
                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EditorLabel}" Style="{StaticResource Heading}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Tên món" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Style="{StaticResource ComboField}" md:HintAssist.Hint="Danh mục" ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CategoryId}"/>
                    <TextBox Style="{StaticResource Field}" md:HintAssist.Hint="Mô tả" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
                    <CheckBox Content="Món đang bán" IsChecked="{Binding IsActive}" Margin="0,0,0,8"/>
                    
                <WrapPanel>
                    <Button Style="{StaticResource SoftButton}" Content="Chọn ảnh" Command="{Binding ImageCommand}"/>
                    <Button Style="{StaticResource SoftButton}" Content="Bỏ ảnh" Command="{Binding ClearImageCommand}"/>
                </WrapPanel>
                <Image Source="{Binding ImagePath, Converter={StaticResource Display}, ConverterParameter=Image}"
                       Height="115" Margin="0,0,0,12" Stretch="Uniform" HorizontalAlignment="Left"
                       Visibility="{Binding ImagePath, Converter={StaticResource Display}, ConverterParameter=Visible}"/>
                    <TextBlock Text="Size và giá bán" Style="{StaticResource Heading}"/>
                    <DataGrid Style="{StaticResource Table}" Height="150" ItemsSource="{Binding Sizes}"
                              IsReadOnly="False" SelectedItem="{Binding SelectedSize}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên size" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            <DataGridTextColumn Header="Giá (đồng)" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Bán" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,8,0,9">
                        <Button Style="{StaticResource SoftButton}" Content="Thêm size" Command="{Binding AddSizeCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Bỏ size đã chọn" Command="{Binding RemoveSizeCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="Topping áp dụng" Style="{StaticResource Heading}"/>
                    <ItemsControl ItemsSource="{Binding Toppings}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Topping.Name}" IsChecked="{Binding Selected}" Margin="0,0,14,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Lưu món" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource SoftButton}" Content="Ngừng bán" Command="{Binding DisableCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
